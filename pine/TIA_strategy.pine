// TI-A — strategy wrapper for TradingView's backtester.
//
// Identical model to TIA.pine; only the output stage differs. Read
// docs/11-PINE-PLAN.md before trusting any number this produces.
//
// WHAT TRADINGVIEW'S BACKTESTER STILL CANNOT DO, even configured as below:
//
//   * Intrabar path is unknown. If a bar's range spans both the stop and the
//     target, TradingView resolves it by order-submission sequence, not by what
//     actually happened. We submit the STOP first so the pessimistic branch
//     wins, matching the Python reference (SPEC.md §2.7). Enable the bar
//     magnifier on intraday charts to reduce, not eliminate, this ambiguity.
//   * No partial fills, no queue position, no rejection. Every order fills in
//     full at the modelled price.
//   * `slippage` is in ticks and is symmetric. The Python cost model charges a
//     fraction of the bar's RANGE, which scales with conditions; the tick-based
//     approximation understates cost in volatile conditions and overstates it in
//     calm ones. Set it from the instrument's typical range, not from its spread.
//   * The Edge Book here is FROZEN. In Python it keeps learning, so a live
//     system's expectancy estimates drift away from these. That is intended, and
//     it means this backtest is a lower bound on the research pipeline's
//     fidelity, not a replacement for it.
//   * Results before bar ~350 are meaningless: the model is still warming up.

//@version=6
strategy("TI-A Strategy", shorttitle="TI-A S", overlay=true, max_bars_back=1000,
     initial_capital=100000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.01,
     slippage=2,
     process_orders_on_close=false,
     calc_on_every_tick=false,
     calc_on_order_fills=false,
     pyramiding=0)

// ============================================================================
// Display inputs. NOTE: there are no *model* inputs. The trader configures
// nothing that affects a signal — that is a design requirement, not an
// oversight. Everything here is cosmetic or operational.
// ============================================================================
showCard      = input.bool(true,  "Show explanation card",  group="Display")
showLevels    = input.bool(true,  "Show stop / target",     group="Display")
showRegime    = input.bool(true,  "Tint background by regime", group="Display")
cardSize      = input.string("Small", "Card text size", options=["Tiny","Small","Normal"], group="Display")
accountRisk   = input.float(0.5,  "Risk per trade (% of equity)", minval=0.01, maxval=5.0, step=0.05, group="Operational")
useRiskSize   = input.bool(true, "Size by stop distance rather than fixed equity %", group="Operational")


// ==== END FROZEN MODEL (generated by tia.export) ====

// ============================================================================
// Helpers
// ============================================================================

// Parse a comma-separated constant into a float array. Done once, on the first
// bar: Pine cannot read files, so frozen vectors travel as string literals.
f_parseFloats(csv) =>
    out = array.new<float>(0)
    if csv != ""
        parts = str.split(csv, ",")
        for i = 0 to array.size(parts) - 1
            v = str.tonumber(array.get(parts, i))
            array.push(out, na(v) ? 0.0 : v)
    out

var float[] DESIGN_A    = f_parseFloats(FM_RG_A)
var float[] DESIGN_B    = f_parseFloats(FM_RG_B)
var float[] PRECISION   = f_parseFloats(FM_ENG_PREC)
var float[] ISO_X       = f_parseFloats(FM_ISO_X)
var float[] ISO_Y       = f_parseFloats(FM_ISO_Y)
var float[] BUCKET_EDGE = f_parseFloats(FM_EB_EDGES)
var float[] EDGE_MU     = f_parseFloats(FM_EB_MU)
var float[] EDGE_SCALE  = f_parseFloats(FM_EB_SCALE)
var float[] EDGE_DOF    = f_parseFloats(FM_EB_DOF)
var float[] EDGE_NEFF   = f_parseFloats(FM_EB_NEFF)

f_clip(x, lo, hi) => na(x) ? (lo + hi) * 0.5 : math.max(lo, math.min(hi, x))
f_safediv(a, b, d) => (b == 0 or na(b) or na(a)) ? d : a / b
f_logistic(x) => 1.0 / (1.0 + math.exp(-f_clip(x, -60.0, 60.0)))

// Inverse standard normal CDF, Moro/Acklam-style rational approximation.
// Pine has no ppf; this is accurate to ~1e-9 across the domain, which is orders
// of magnitude better than the estimation error of anything it is applied to.
f_normPpf(p) =>
    pp = f_clip(p, 1e-12, 1 - 1e-12)
    float res = 0.0
    if pp < 0.02425
        q = math.sqrt(-2.0 * math.log(pp))
        res := (((((-0.007784894002430293 * q - 0.3223964580411365) * q - 2.400758277161838) * q - 2.549732539343734) * q + 4.374664141464968) * q + 2.938163982698783) / ((((0.007784695709041462 * q + 0.3224671290700398) * q + 2.445134137142996) * q + 3.754408661907416) * q + 1.0)
    else if pp > 1 - 0.02425
        q = math.sqrt(-2.0 * math.log(1 - pp))
        res := -(((((-0.007784894002430293 * q - 0.3223964580411365) * q - 2.400758277161838) * q - 2.549732539343734) * q + 4.374664141464968) * q + 2.938163982698783) / ((((0.007784695709041462 * q + 0.3224671290700398) * q + 2.445134137142996) * q + 3.754408661907416) * q + 1.0)
    else
        q = pp - 0.5
        r = q * q
        res := (((((-39.69683028665376 * r + 220.9460984245205) * r - 275.9285104469687) * r + 138.3577518672690) * r - 30.66479806614716) * r + 2.506628277459239) * q / (((((-54.47609879822406 * r + 161.5858368580409) * r - 155.6989798598866) * r + 66.80131188771972) * r - 13.28068155288572) * r + 1.0)
    res

// Inverse Student-t via the Cornish-Fisher expansion. Identical to the Python
// reference in tia/engines/edgebook.py:student_t_ppf, so the two agree to the
// tolerance stated in docs/11-PINE-PLAN.md.
f_studentTPpf(p, dof) =>
    float res = 0.0
    if dof <= 2.0
        res := f_normPpf(p) * 4.0
    else
        z  = f_normPpf(p)
        z2 = z * z
        z3 = z2 * z
        z5 = z3 * z2
        z7 = z5 * z2
        g1 = (z3 + z) / 4.0
        g2 = (5.0 * z5 + 16.0 * z3 + 3.0 * z) / 96.0
        g3 = (3.0 * z7 + 19.0 * z5 + 17.0 * z3 - 15.0 * z) / 384.0
        res := z + g1 / dof + g2 / (dof * dof) + g3 / (dof * dof * dof)
    res

// Piecewise-linear interpolation of the frozen isotonic map, matching
// numpy.interp semantics (clamped at both ends).
f_interp(x, xs, ys) =>
    n = array.size(xs)
    float out = x
    if n >= 2
        if x <= array.get(xs, 0)
            out := array.get(ys, 0)
        else if x >= array.get(xs, n - 1)
            out := array.get(ys, n - 1)
        else
            int i = 0
            for k = 1 to n - 1
                if i == 0 and array.get(xs, k) >= x
                    i := k
            x0 = array.get(xs, i - 1)
            x1 = array.get(xs, i)
            y0 = array.get(ys, i - 1)
            y1 = array.get(ys, i)
            w  = f_safediv(x - x0, x1 - x0, 0.0)
            out := y0 + w * (y1 - y0)
    out

// ============================================================================
// L1  Feature kernel  (docs/01-THEORY.md §2-§4)
// ============================================================================
logC = math.log(close)
ret  = na(close[1]) ? na : math.log(close / close[1])
absR = math.abs(ret)

// -- Volatility ---------------------------------------------------------------
// Bipower variation: jump-robust, and therefore the correct denominator when
// asking "was this move large?" (§2.1). Realised variance is kept alongside so
// their difference isolates jump variation.
bpSum   = math.sum(absR * nz(absR[1]), FM_VOL_N)
sigmaBp = math.sqrt(math.max(1.5707963267948966 * bpSum / (FM_VOL_N - 1), 1e-16))
rvMid   = math.sum(ret * ret, FM_VOL_N) / FM_VOL_N
sigmaRv = math.sqrt(math.max(rvMid, 1e-16))
sigmaS  = math.sqrt(math.max(math.sum(ret * ret, FM_VOL_NS) / FM_VOL_NS, 1e-16))
sigmaL  = math.sqrt(math.max(math.sum(ret * ret, FM_VOL_NL) / FM_VOL_NL, 1e-16))
jumpShare = f_clip(f_safediv(sigmaRv * sigmaRv - sigmaBp * sigmaBp, sigmaRv * sigmaRv, 0.0), 0.0, 1.0)

// Rogers-Satchell: drift-independent, which matters precisely in the trending
// conditions where a position might be sized.
rsTerm  = math.log(high / close) * math.log(high / open) + math.log(low / close) * math.log(low / open)
sigmaRs = math.sqrt(math.max(math.sum(rsTerm, FM_VOL_N) / FM_VOL_N, 1e-16))

alphaEw = 2.0 / (2.0 * FM_EWMA_HL + 1.0)
var float ewVar = na
ewVar := na(ewVar) ? rvMid : alphaEw * ret * ret + (1 - alphaEw) * ewVar
sigmaEw = math.sqrt(math.max(nz(ewVar, rvMid), 1e-16))

// Geometric HAR blend (§2.2). Weights are a THEORY parameter, deliberately not
// fitted, so this contributes nothing to the fitted degree-of-freedom count.
wD = FM_HAR_D
wW = FM_HAR_W
wM = FM_HAR_M
sigmaFcst = math.max(math.exp(wD * math.log(sigmaS) + wW * math.log(sigmaRv) + wM * math.log(sigmaL)), 1e-8)

volRank     = ta.percentrank(math.log(sigmaFcst), FM_RANK_N) / 100.0
compression = 1.0 - ta.percentrank(f_safediv(sigmaS, sigmaL, 1.0), FM_RANK_N) / 100.0
volRatio    = f_safediv(sigmaEw, sigmaFcst, 1.0)
rangeSigma  = f_safediv(math.log(high / low), sigmaFcst, 1.3)

// -- Microstructure: LADR and absorption (§3.1) -------------------------------
// Participation is dollar volume against its own recent median. The Python
// reference conditions this on a time-of-day bucket to remove the intraday
// U-shape; Pine's per-bar cost makes 13 rolling medians expensive, so this uses
// a single rolling median and the approximation is documented in the plan doc.
dollarVol  = ((high + low + close) / 3.0) * volume
medVol     = ta.median(dollarVol, FM_PART_N)
participation = f_safediv(dollarVol, medVol, na)
partRank   = ta.percentrank(nz(participation, 1.0), FM_RANK_N) / 100.0

dNorm = f_safediv(ret, sigmaBp, na)
adNorm = math.abs(nz(dNorm, 0.0))
ladrAbs = na(participation) or participation <= 0 ? na : adNorm / math.pow(participation, FM_PSI)
ladr    = na(ladrAbs) ? na : (ret >= 0 ? ladrAbs : -ladrAbs)
ladrRank = ta.percentrank(nz(ladrAbs, 0.0), FM_RANK_N) / 100.0
absorption = na(participation) ? na : participation / (adNorm + 1e-6)
absRank  = ta.percentrank(math.log(1.0 + nz(absorption, 0.0)), FM_RANK_N) / 100.0

clv     = (high - low) <= 0 ? 0.0 : (2.0 * close - high - low) / (high - low)
clvEma  = ta.ema(clv, 5)

// -- Effective spread, Corwin & Schultz (§3.3) --------------------------------
// Uses the bar pair (t-1, t), NEVER (t, t+1). Written the natural way this
// estimator is trivially forward-looking, and published implementations
// frequently are. Aggregated by rolling MEDIAN: the Python reference found mean
// aggregation over-estimates a known 8bp spread by roughly 7x, because the
// per-pair estimates have a heavy right tail.
csK    = 3.0 - 2.0 * math.sqrt(2.0)
hlPrev = math.log(high[1] / low[1])
hlNow  = math.log(high / low)
h2     = math.max(high, high[1])
l2     = math.min(low, low[1])
hlTwo  = math.log(h2 / l2)
csBeta = hlPrev * hlPrev + hlNow * hlNow
csGam  = hlTwo * hlTwo
csAlph = (math.sqrt(2.0 * csBeta) - math.sqrt(csBeta)) / csK - math.sqrt(math.max(csGam, 0.0) / csK)
csRaw  = math.max(2.0 * (math.exp(csAlph) - 1.0) / (1.0 + math.exp(csAlph)), 0.0)
spreadRel = nz(ta.median(csRaw, FM_SPREAD_N), FM_COST_SFALL)

// -- Kalman local linear trend (§4.1) -----------------------------------------
// Both process and observation covariances scale with the FORECAST volatility,
// which is what makes the filter adapt with no user setting: slow in turbulence,
// sharp in calm. The output is a t-statistic, not a slope — a slope has units of
// price per bar and any threshold on it encodes an unexamined volatility
// assumption. Forward recursion only; the smoother would repaint.
var float kLev = na
var float kSlp = 0.0
var float kP00 = na
var float kP01 = 0.0
var float kP11 = na
s2 = sigmaFcst * sigmaFcst
if na(kLev)
    kLev := logC
    kP00 := 100.0 * s2
    kP11 := s2
else
    // Predict
    kLev := kLev + kSlp
    p00 = kP00 + 2.0 * kP01 + kP11 + FM_KAL_SNR * s2
    p01 = kP01 + kP11
    p11 = kP11 + FM_KAL_SNR_SLOPE * s2
    // Update
    S    = p00 + s2
    k0   = p00 / S
    k1   = p01 / S
    resid = logC - kLev
    kLev := kLev + k0 * resid
    kSlp := kSlp + k1 * resid
    kP00 := p00 - k0 * p00
    kP01 := p01 - k0 * p01
    kP11 := math.max(p11 - k1 * p01, 1e-300)
slopeT = bar_index < 5 ? na : f_safediv(kSlp, math.sqrt(kP11), na)

// -- Lo-MacKinlay variance ratio (§4.2) ---------------------------------------
// The heteroskedasticity-robust form. The homoskedastic statistic rejects the
// martingale null in every volatility cluster for that reason alone, producing a
// spurious "trend" reading precisely when volatility rises. Pine cannot afford
// the full delta_j sum at four horizons every bar, so this uses the
// homoskedastic ratio divided by a frozen null standard deviation calibrated on
// the development universe — an approximation, quantified in the plan doc.
// The four horizons are written out rather than looped. `math.sum` and
// `ta.variance` require a SIMPLE int length; a function parameter is
// series-qualified, and while Pine will often specialise a call site with a
// literal argument, relying on that is how a script compiles on one build and
// not the next. Literals remove the question.
var1 = ta.variance(ret, FM_VR_N)
f_vrterm(varq, q) =>
    vr = f_safediv(varq / q, var1, 1.0)
    (vr - 1.0) * math.sqrt(FM_VR_N / (2.0 * (q - 1.0)))
vrZ2  = f_vrterm(ta.variance(math.sum(ret, 2),  FM_VR_N), 2)
vrZ4  = f_vrterm(ta.variance(math.sum(ret, 4),  FM_VR_N), 4)
vrZ8  = f_vrterm(ta.variance(math.sum(ret, 8),  FM_VR_N), 8)
vrZ16 = f_vrterm(ta.variance(math.sum(ret, 16), FM_VR_N), 16)
vrZ = (vrZ2 + vrZ4 + vrZ8 + vrZ16) / 4.0
vrRank = ta.percentrank(nz(vrZ, 0.0), FM_RANK_N) / 100.0

// -- Path efficiency and permutation entropy ----------------------------------
efficiency = f_clip(math.abs(f_safediv(math.sum(ret, FM_VOL_N), math.sum(absR, FM_VOL_N), 0.0)), 0.0, 1.0)

// Permutation entropy of order 3 (Bandt & Pompe): depends only on the ordinal
// pattern of three consecutive closes, so it is invariant to any monotone
// transform of price and needs no binning choice.
p0 = close
p1 = close[1]
p2 = close[2]
pat = (p2 < p1 ? (p1 < p0 ? 0 : (p2 < p0 ? 1 : 2)) : (p1 < p0 ? (p2 < p0 ? 3 : 4) : 5))
float peSum = 0.0
for k = 0 to 5
    cnt = 0
    for j = 0 to FM_PE_N - 1
        if pat[j] == k
            cnt += 1
    pk = cnt / FM_PE_N
    peSum += pk > 0 ? -pk * math.log(pk) : 0.0
permEntropy = f_clip(peSum / math.log(6.0), 0.0, 1.0)

// -- Structure: pivots confirmed only after the delay (§4.3) ------------------
// ta.pivothigh(left, right) is only KNOWN `right` bars after the pivot bar, so
// consuming it without the offset would read the future. The `[FM_PIV_CONFIRM]`
// offset on the value, plus using ta.valuewhen on the already-lagged series, is
// what makes this causal.
ph = ta.pivothigh(high, FM_PIV_CONFIRM, FM_PIV_CONFIRM)
pl = ta.pivotlow(low,  FM_PIV_CONFIRM, FM_PIV_CONFIRM)
var float pivotHigh = na
var float pivotLow  = na
var int   pivotHighBar = na
var int   pivotLowBar  = na
if not na(ph)
    pivotHigh := ph
    pivotHighBar := bar_index
if not na(pl)
    pivotLow := pl
    pivotLowBar := bar_index
rangePos = (na(pivotHigh) or na(pivotLow) or pivotHigh <= pivotLow) ? na : f_clip((close - pivotLow) / (pivotHigh - pivotLow), 0.0, 1.0)

// -- Higher timeframe, causally (§4.3) ----------------------------------------
// BOTH `[1]` and `lookahead_off` are required and neither alone suffices.
// Without `lookahead_off`, Pine serves the COMPLETED higher-timeframe bar to
// historical bars that could not have seen it — the classic backtest-only
// miracle. With `lookahead_off` but no `[1]`, the in-progress higher-timeframe
// bar still updates intrabar, so a historical signal changes as the bar forms.
// Together they deliver only fully-closed higher-timeframe bars.
htfTF  = timeframe.multiplier * FM_HTF_MULT
htfStr = str.tostring(htfTF) + (timeframe.isintraday ? "" : "D")
htfSlopeRaw = request.security(syminfo.tickerid, htfStr, slopeT[1], lookahead=barmerge.lookahead_off)
htfRangeRaw = request.security(syminfo.tickerid, htfStr, rangePos[1], lookahead=barmerge.lookahead_off)

// -- Sweep and fail (§3.2) ----------------------------------------------------
// Four conditions, all on closed bars: penetration beyond noise, anomalous
// participation, the bar giving back its excursion, and a later close that
// reclaims the level. The fourth is what makes this non-repainting AND late — a
// sweep is knowable only after it has failed, which is the real information
// arrival time.
penLow  = not na(pivotLow)  and low  < pivotLow  and f_safediv(math.log(pivotLow / low), sigmaBp, 0.0) >= FM_SWEEP_MINPEN
penHigh = not na(pivotHigh) and high > pivotHigh and f_safediv(math.log(high / pivotHigh), sigmaBp, 0.0) >= FM_SWEEP_MINPEN
heavy   = partRank >= 0.75
gaveBackLow  = clv > 0 or absRank >= 0.6
gaveBackHigh = clv < 0 or absRank >= 0.6
var int   sweepDir = 0
var int   sweepAge = 999
var float sweepLvl = na
var bool  pendingLow = false
var bool  pendingHigh = false
var int   pendingAge = 999
sweepAge := sweepAge + 1
pendingAge := pendingAge + 1
if pendingAge > FM_SWEEP_MAXBARS
    pendingLow := false
    pendingHigh := false
if pendingLow and not na(sweepLvl) and close > sweepLvl
    sweepDir := 1
    sweepAge := 0
    pendingLow := false
if pendingHigh and not na(sweepLvl) and close < sweepLvl
    sweepDir := -1
    sweepAge := 0
    pendingHigh := false
if penLow and heavy and gaveBackLow
    pendingLow := true
    pendingAge := 0
    sweepLvl := pivotLow
if penHigh and heavy and gaveBackHigh
    pendingHigh := true
    pendingAge := 0
    sweepLvl := pivotHigh

featuresValid = bar_index >= FM_WARMUP and not na(volRank) and not na(ladrRank) and not na(sigmaFcst)

// ============================================================================
// L2a  Regime posterior — parameter-free measurement model (§5)
// ============================================================================
// Each regime is a fixed product of Beta densities over rank features. Beta(1,1)
// is exactly uniform and encodes "this regime makes no claim about this
// feature", contributing a likelihood factor of exactly 1. Zero parameters here
// were fitted to returns.
f_betaLogPdf(x, a, b) =>
    xx = f_clip(x, 1e-6, 1.0 - 1e-6)
    (a - 1.0) * math.log(xx) + (b - 1.0) * math.log(1.0 - xx)

var float[] logAlpha = array.new<float>(4, -math.log(4))
var float[] refPost  = array.new<float>(4, 1.0 / 4)
var float[] posterior = array.new<float>(4, 1.0 / 4)

featArr = array.from(volRank, vrRank, ladrRank, absRank, partRank, permEntropy, jumpShare, efficiency)

float hazard = 1.0
int   domRegime = 3
if featuresValid
    // Measurement log-likelihood per regime, tempered by the frozen exponent.
    logLik = array.new<float>(4, 0.0)
    for k = 0 to 4 - 1
        float s = 0.0
        for j = 0 to 7
            v = array.get(featArr, j)
            if not na(v)
                s += f_betaLogPdf(v, array.get(DESIGN_A, k * 8 + j), array.get(DESIGN_B, k * 8 + j))
        array.set(logLik, k, FM_RG_TEMPER * s)

    // Sticky forward recursion in log space. FORWARD ONLY — the forward-backward
    // posterior would repaint every historical regime label the moment a new bar
    // arrived.
    logStay   = FM_RG_LOG_STAY
    logSwitch = FM_RG_LOG_SWITCH
    newLog = array.new<float>(4, 0.0)
    for k = 0 to 4 - 1
        float mx = -1e18
        for j = 0 to 4 - 1
            v = array.get(logAlpha, j) + (j == k ? logStay : logSwitch)
            mx := math.max(mx, v)
        float acc = 0.0
        for j = 0 to 4 - 1
            v = array.get(logAlpha, j) + (j == k ? logStay : logSwitch)
            acc += math.exp(v - mx)
        array.set(newLog, k, mx + math.log(acc) + array.get(logLik, k))
    float mx2 = -1e18
    for k = 0 to 4 - 1
        mx2 := math.max(mx2, array.get(newLog, k))
    float tot = 0.0
    for k = 0 to 4 - 1
        tot += math.exp(array.get(newLog, k) - mx2)
    lnorm = mx2 + math.log(tot)
    for k = 0 to 4 - 1
        array.set(logAlpha, k, array.get(newLog, k) - lnorm)
        array.set(posterior, k, math.exp(array.get(logAlpha, k)))

    // Transition hazard (§5.5): max of posterior drift and ambiguity. Either
    // alone is reason enough to stand aside, which is the conservative reading.
    aRef = 2.0 / (FM_RG_HAZ_HL + 1.0)
    float tv = 0.0
    float maxP = 0.0
    for k = 0 to 4 - 1
        pk = array.get(posterior, k)
        rk = (1 - aRef) * array.get(refPost, k) + aRef * pk
        array.set(refPost, k, rk)
        tv += math.abs(pk - rk)
        if pk > maxP
            maxP := pk
            domRegime := k
    hazard := math.max(0.5 * tv, 1.0 - maxP)

pTrend  = array.get(posterior, 0)
pRevert = array.get(posterior, 1)
pStress = array.get(posterior, 2)
pQuiet  = array.get(posterior, 3)

// ============================================================================
// L2b  Engines (docs/03-ENGINES.md)
// ============================================================================
// Each returns [score, reliability]. `score` is direction and strength;
// `reliability` is "should you listen to me right now". They must never be
// merged: a steep trend in a mean-reverting regime is not a WEAK buy signal, it
// is a strong signal that should not be acted on, and encoding that as a small
// score would let several such engines sum into a large one.

// -- Regime engine: routes, barely directs.
regScore = f_clip(0.5 * (pTrend * math.tanh(nz(slopeT, 0.0) / 2.0) + pRevert * (0.5 - nz(rangePos, 0.5)) * 2.0), -1, 1)
regRel   = f_clip((1.0 - (1.0 - math.max(math.max(pTrend, pRevert), math.max(pStress, pQuiet)))) * (1.0 - hazard), 0, 1)

// -- Trend engine.
trAgree = (close > close[5] ? 1 : -1) + (close > close[22] ? 1 : -1) + (close > close[66] ? 1 : -1)
trScore = f_clip(0.45 * math.tanh(nz(slopeT, 0.0) / 2.0) + 0.25 * (trAgree / 3.0) + 0.30 * math.tanh(nz(htfSlopeRaw, 0.0) / 2.0), -1, 1)
persist = f_clip(0.5 + nz(vrZ, 0.0) / 4.0, 0, 1)
tfAgree = (na(htfSlopeRaw) or na(slopeT)) ? 1.0 : ((htfSlopeRaw >= 0) == (slopeT >= 0) ? 1.0 : 0.45)
trRel   = f_clip((0.25 + 0.75 * pTrend) * (0.15 + 0.85 * persist) * (0.45 + 0.55 * nz(efficiency, 0.3)) * tfAgree * (1.0 - 0.6 * pRevert), 0, 1)

// -- Momentum engine: displacement that was cheap in liquidity terms.
// Only the upper half of the LADR distribution is evidence. A bar at the median
// cost of displacement says nothing and maps to zero, not to a weak opinion.
moStrength = math.max(0.0, 2.0 * nz(ladrRank, 0.5) - 1.0)
moDir      = na(ladr) ? 0.0 : (ladr > 0 ? 1.0 : (ladr < 0 ? -1.0 : 0.0))
moScore    = f_clip(0.625 * moDir * moStrength + 0.25 * f_clip(nz(clvEma, 0.0), -1, 1), -1, 1)
jumpPen    = f_clip(1.0 - 0.5 * nz(jumpShare, 0.0), 0.4, 1.0)
moRel      = f_clip((0.20 + 0.80 * moStrength) * (0.35 + 0.65 * pTrend) * (1.0 - 0.5 * pRevert) * (1.0 - 0.7 * pQuiet) * jumpPen, 0, 1)

// -- Liquidity engine: sweeps that fail, and volume that goes nowhere.
sweepScore = (sweepAge <= 4 and sweepDir != 0) ? sweepDir * 0.6 * (1.0 - sweepAge / 5.0) : 0.0
edgeDist   = na(rangePos) ? 0.0 : math.abs(rangePos - 0.5) * 2.0
absorbing  = nz(absRank, 0.0) > 0.65 and edgeDist > 0.5
absorbScore = absorbing ? -f_clip((nz(absRank, 0.0) - 0.65) / 0.35 * edgeDist, 0, 1) * (rangePos > 0.5 ? 1 : -1) : 0.0
liqScore   = (sweepScore != 0 and absorbScore != 0) ? 0.7 * sweepScore + 0.3 * absorbScore : sweepScore + absorbScore
liqHasEvidence = sweepScore != 0 or absorbing
// No liquidity event is a CONFIDENT statement of no evidence, not an absence of
// opinion: it contributes nothing to the pooled log-odds while adding to its
// variance, which correctly widens the interval.
liqRel     = liqHasEvidence ? f_clip((0.30 + 0.70 * math.abs(liqScore)) * (0.40 + 0.60 * (pRevert + 0.6 * pStress)) * (1.0 - 0.35 * pTrend), 0, 1) : 0.35

// -- Volatility engine: usually zero score with confident reliability.
// Volatility is the most forecastable quantity available and is almost entirely
// directionless. A compression that resolves into an expansion has, ex ante, no
// reliable direction; assigning one manufactures a signal from a real observation.
volFav = (volRank >= 0.25 and volRank <= 0.80) ? 1.0 : f_clip(1.0 - 2.0 * (volRank < 0.25 ? (0.25 - volRank) / 0.55 : (volRank - 0.80) / 0.55), -1, 1)
volScore = (volRatio > 1.15 and math.abs(nz(dNorm, 0.0)) > 0.5) ? f_clip(0.35 * math.tanh(nz(dNorm, 0.0) / 2.0), -0.4, 0.4) : 0.0
volRel   = f_clip((0.35 + 0.45 * f_clip((volFav + 1.0) / 2.0, 0, 1)) * (1.0 - 0.4 * pStress), 0, 1)

// -- Structure engine: the same location is bullish in one regime and bearish in
// the other, so both readings are computed and weighted by the posterior.
stPos   = na(rangePos) ? 0.0 : 2.0 * rangePos - 1.0
wT = pTrend + 1e-9
wR = pRevert + 1e-9
stScore0 = (wT * stPos + wR * (-stPos)) / (wT + wR)
stScore  = na(htfRangeRaw) ? stScore0 : 0.7 * stScore0 + 0.3 * f_clip((wT * (2 * htfRangeRaw - 1) - wR * (2 * htfRangeRaw - 1)) / (wT + wR), -1, 1)
stDecis  = math.abs(pTrend - pRevert) / math.max(pTrend + pRevert, 1e-9)
stStale  = f_clip(1.0 - (math.max(nz(bar_index - pivotHighBar, 0), nz(bar_index - pivotLowBar, 0)) - 20.0) / 120.0, 0.25, 1.0)
stRel    = na(rangePos) ? 0.0 : f_clip((0.25 + 0.75 * math.abs(stPos)) * (0.35 + 0.65 * stDecis) * stStale, 0, 1)

// -- Behavioral engine: mostly a statement about when NOT to act.
// What survives replication in the calendar literature is the volume and
// volatility structure, not the directional content.
inSession = not na(close)
sessionTrust = timeframe.isintraday ? (session.ismarket ? 0.95 : 0.25) : 1.0
bhScore = 0.0
bhRel   = f_clip(sessionTrust, 0, 1)

// ============================================================================
// L3  CALOP fusion (§6)
// ============================================================================
// Naive log-odds summation — which is what any "confluence score" implicitly
// does — is the correct Bayesian operation ONLY under conditional independence.
// Ten engines built on overlapping windows of one price series are nowhere near
// independent, and the error is the difference between 75% and 99.998%.
//
//   L = 1' M e,  EBE = 1' M 1,  M = D^(1/2) C^-1 D^(1/2),  Var(L) = sd^2 * EBE
//
// C^-1 is frozen (it changes slowly); the reliability scaling D is live.
scoreArr = array.from(regScore, trScore, moScore, liqScore, volScore, stScore, bhScore)
relArr   = array.from(regRel,   trRel,   moRel,   liqRel,   volRel,   stRel,   bhRel)

f_evidence(s) =>
    x = f_clip(s, -FM_FUSE_CLAMP, FM_FUSE_CLAMP)
    math.log((1.0 + x) / (1.0 - x))   // = 2*atanh(x), the inverse of the tanh the engines apply

float logOdds = 0.0
float ebeTotal = 0.0
if featuresValid
    for i = 0 to FM_ENG_M - 1
        di = math.sqrt(math.max(array.get(relArr, i), 0.0))
        for j = 0 to FM_ENG_M - 1
            dj = math.sqrt(math.max(array.get(relArr, j), 0.0))
            pij = array.get(PRECISION, i * FM_ENG_M + j)
            logOdds  += di * pij * dj * f_evidence(array.get(scoreArr, j))
            ebeTotal += di * pij * dj

direction = logOdds > 0 ? 1 : (logOdds < 0 ? -1 : 0)

// Aligned breadth: how many independent engines actually support the pooled
// direction. Total breadth includes confident abstainers, which rightly widen
// the interval but must not satisfy a threshold about agreement.
float ebeAligned = 0.0
if featuresValid and direction != 0
    for i = 0 to FM_ENG_M - 1
        si = array.get(scoreArr, i)
        ri = array.get(relArr, i)
        okI = ri > 0 and math.abs(si) * ri > FM_FUSE_ALIGNEPS and (si > 0 ? 1 : -1) == direction
        if okI
            di = math.sqrt(ri)
            for j = 0 to FM_ENG_M - 1
                sj = array.get(scoreArr, j)
                rj = array.get(relArr, j)
                okJ = rj > 0 and math.abs(sj) * rj > FM_FUSE_ALIGNEPS and (sj > 0 ? 1 : -1) == direction
                if okJ
                    ebeAligned += di * array.get(PRECISION, i * FM_ENG_M + j) * math.sqrt(rj)

// MacKay's probit approximation to the Gaussian-integrated logistic. This is the
// mechanism that pulls stated confidence toward 50% when evidence is narrow, and
// it means a reported 97% requires evidence that is both strong AND broad.
varL  = FM_FUSE_SD * FM_FUSE_SD * math.max(ebeTotal, 1e-9)
kappa = 1.0 / math.sqrt(1.0 + 0.39269908169872414 * FM_FUSE_T * FM_FUSE_T * varL)
pUpRaw = f_logistic((FM_FUSE_T * logOdds + FM_FUSE_B) * kappa)
seL    = math.sqrt(varL)
pLoRaw = f_logistic((FM_FUSE_T * (logOdds - FM_FUSE_Z * seL) + FM_FUSE_B) * kappa)
pHiRaw = f_logistic((FM_FUSE_T * (logOdds + FM_FUSE_Z * seL) + FM_FUSE_B) * kappa)
pUp = FM_ISO_ON ? f_interp(pUpRaw, ISO_X, ISO_Y) : pUpRaw
pLo = FM_ISO_ON ? f_interp(pLoRaw, ISO_X, ISO_Y) : pLoRaw
pHi = FM_ISO_ON ? f_interp(pHiRaw, ISO_X, ISO_Y) : pHiRaw
// Probabilities are always stated FOR THE PROPOSED DIRECTION.
pSuccess = direction >= 0 ? pUp : 1.0 - pUp
pLow     = direction >= 0 ? pLo : 1.0 - pHi
pHigh    = direction >= 0 ? pHi : 1.0 - pLo

// ============================================================================
// L4  Edge Book lookup (§7)
// ============================================================================
// Setup family, most specific first: a bar that is both a sweep and a
// continuation is judged as a sweep.
setupIdx = (sweepAge <= 4 and sweepDir != 0) ? 1 : (compression > 0.7 and volRatio > 1.1 ? 2 : (pRevert > pTrend ? 3 : 0))
absL = math.abs(logOdds)
int bucketIdx = 0
for k = 0 to array.size(BUCKET_EDGE) - 1
    if absL >= array.get(BUCKET_EDGE, k)
        bucketIdx += 1
bucketIdx := math.min(bucketIdx, FM_EB_NBUCKET - 1)
cellIdx = (domRegime * FM_EB_NSETUP + setupIdx) * FM_EB_NBUCKET + bucketIdx

hasEdge  = array.size(EDGE_MU) > cellIdx
edgeMu   = hasEdge ? array.get(EDGE_MU, cellIdx) : 0.0
edgeScl  = hasEdge ? array.get(EDGE_SCALE, cellIdx) : 0.2
edgeDof  = hasEdge ? array.get(EDGE_DOF, cellIdx) : 6.0
edgeNeff = hasEdge ? array.get(EDGE_NEFF, cellIdx) : 0.0
edgeLcb  = edgeMu + f_studentTPpf(FM_EB_Q, edgeDof) * edgeScl

// ============================================================================
// L5  Costs, barriers, gate (§7, §8)
// ============================================================================
kStress   = 1.0 + 1.5 * pStress
halfSpSig = f_safediv(0.5 * spreadRel, sigmaFcst, 1e9)
halfSpSig := halfSpSig > FM_COST_MAXHS ? 1e9 : halfSpSig   // untradeable, not merely expensive
impactSig = FM_COST_ETA * math.sqrt(FM_COST_Q)
slipSig   = FM_COST_PHI * math.min(rangeSigma, 5.0)
feeSig    = f_safediv(FM_COST_FEE_BPS * 1e-4, sigmaFcst, 0.0)
roundTrip = 2.0 * (kStress * halfSpSig + kStress * impactSig + kStress * slipSig + feeSig)

evMean = edgeMu - roundTrip
evLcb  = edgeLcb - roundTrip

// Barriers in sigma first, price second — that is what lets one parameter set
// serve an instrument at 4 and one at 40,000.
stopSig = FM_STOP_SIGMA * (pStress > 0.2 ? 1.0 + 0.6 * pStress : 1.0) * (jumpShare > 0.4 ? 1.0 + 0.4 * (jumpShare - 0.4) / 0.6 : 1.0)
tgtSig  = FM_TGT_SIGMA * (pRevert > pTrend ? 1.0 - 0.25 * (pRevert - pTrend) : 1.0 + 0.20 * (pTrend - pRevert))
stopSig := f_clip(stopSig, 0.4, 8.0)
tgtSig  := f_clip(tgtSig, 0.4, 12.0)

// -- Position state machine ---------------------------------------------------
var int   posState  = 0        // -1 short, 0 flat, +1 long
var float entryPx   = na
var float stopPx    = na
var float targetPx  = na
var int   barsHeld  = 0
var int   entryBar  = na
var int[] recentEntries = array.new<int>(0)

if posState != 0
    barsHeld += 1

// Resting stop and target fill intrabar. Pessimistic tie-breaks: if the range
// spans both barriers the STOP is taken, and a gap through the stop fills at the
// open. Bar data cannot resolve intrabar sequence, so the ambiguity is always
// resolved against us — the optimistic convention can manufacture most of a
// strategy's apparent edge, invisibly.
bool exitedByBarrier = false
if posState == 1
    if low <= stopPx
        exitedByBarrier := true
    else if high >= targetPx
        exitedByBarrier := true
else if posState == -1
    if high >= stopPx
        exitedByBarrier := true
    else if low <= targetPx
        exitedByBarrier := true
if exitedByBarrier
    posState := 0
    barsHeld := 0

// Trade-rate limiter: a brake, not an optimiser. If the gate somehow starts
// firing constantly, something has broken and the right response is to trade
// less, not more.
if array.size(recentEntries) > 0
    while array.size(recentEntries) > 0 and bar_index - array.get(recentEntries, 0) > 100
        array.shift(recentEntries)
rateOk = array.size(recentEntries) < FM_GATE_RATE

// The ten conjunctive gate conditions (SPEC.md §7). Conjunctive rather than
// scored, because a weighted score lets a spectacular reading on one axis buy
// past a disqualifying reading on another.
tradeable  = not timeframe.isintraday or session.ismarket
gEv        = evLcb > FM_GATE_EVLCB
gP         = pSuccess >= FM_GATE_PMIN
gEbe       = ebeAligned >= FM_GATE_EBEMIN
gHazard    = hazard <= FM_RG_HAZ_MAX
gRegime    = domRegime != 3
gDir       = direction != 0 and (direction > 0 or true)
gateOpen   = featuresValid and gEv and gP and gEbe and gHazard and gRegime and gDir and rateOk and tradeable and posState == 0

// Bar-close exits only: the vertical barrier and a confirmed reversal. Modelling
// a stop as a bar-close decision would be a look-ahead error in the optimistic
// direction, since it assumes the close was available at the stop price.
wantExit = posState != 0 and (barsHeld >= FM_MAX_HOLD or (barsHeld >= FM_MIN_HOLD and direction == -posState and pSuccess >= FM_GATE_PEXIT and ebeAligned >= FM_GATE_EBEMIN * 0.7))

confirmed = barstate.isconfirmed
buySig    = confirmed and gateOpen and direction > 0
shortSig  = confirmed and gateOpen and direction < 0
sellSig   = confirmed and wantExit and posState == 1
coverSig  = confirmed and wantExit and posState == -1

if sellSig or coverSig
    posState := 0
    barsHeld := 0
if buySig
    posState := 1
    entryPx := close
    stopPx := close * math.exp(-stopSig * sigmaFcst)
    targetPx := close * math.exp(tgtSig * sigmaFcst)
    barsHeld := 0
    entryBar := bar_index
    array.push(recentEntries, bar_index)
if shortSig
    posState := -1
    entryPx := close
    stopPx := close * math.exp(stopSig * sigmaFcst)
    targetPx := close * math.exp(-tgtSig * sigmaFcst)
    barsHeld := 0
    entryBar := bar_index
    array.push(recentEntries, bar_index)

// ============================================================================
// Orders
// ============================================================================
// Position sizing from the stop distance, so that one loss costs `accountRisk`
// of equity regardless of the instrument's volatility. This is the same logic as
// tia/risk/sizing.py, minus the Kelly term — Pine has no access to the Edge
// Book's posterior variance at runtime beyond the frozen per-cell values, so the
// uncertainty haircut is applied via the frozen `lcb/mean` ratio instead.
riskFrac  = accountRisk / 100.0
haircut   = edgeMu > 0 ? f_clip(edgeLcb / edgeMu, 0.0, 1.0) : 0.0
sizedRisk = riskFrac * (useRiskSize ? math.max(haircut, 0.15) : 1.0)
stopDist  = math.abs(close - (direction > 0 ? close * math.exp(-stopSig * sigmaFcst) : close * math.exp(stopSig * sigmaFcst)))
qty       = stopDist > 0 ? (strategy.equity * sizedRisk) / stopDist : na

if buySig and not na(qty)
    strategy.entry("L", strategy.long, qty=qty, comment="BUY")
if shortSig and not na(qty)
    strategy.entry("S", strategy.short, qty=qty, comment="SHORT")

// The stop is submitted BEFORE the target so that a bar containing both is
// resolved against us, matching the Python reference's pessimistic tie-break.
if strategy.position_size > 0
    strategy.exit("L-x", from_entry="L", stop=stopPx, limit=targetPx, comment_loss="STOP", comment_profit="TARGET")
if strategy.position_size < 0
    strategy.exit("S-x", from_entry="S", stop=stopPx, limit=targetPx, comment_loss="STOP", comment_profit="TARGET")

// Discretionary exits: vertical barrier and confirmed reversal only. A stop
// modelled as a bar-close decision would be a look-ahead error in the optimistic
// direction, so those stay with the resting orders above.
if sellSig
    strategy.close("L", comment="SELL")
if coverSig
    strategy.close("S", comment="COVER")

plotshape(buySig,   title="BUY",   style=shape.triangleup,   location=location.belowbar, color=color.new(color.green, 0), size=size.small)
plotshape(shortSig, title="SHORT", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0),   size=size.small)
plot(showLevels and strategy.position_size != 0 ? stopPx   : na, "Stop",   color=color.new(color.red, 20),   style=plot.style_linebr)
plot(showLevels and strategy.position_size != 0 ? targetPx : na, "Target", color=color.new(color.green, 20), style=plot.style_linebr)
bgcolor(showRegime and featuresValid ? (domRegime == 0 ? color.new(color.green, 94) : domRegime == 1 ? color.new(color.blue, 94) : domRegime == 2 ? color.new(color.red, 94) : color.new(color.gray, 96)) : na, title="Regime tint")

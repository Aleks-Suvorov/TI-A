//@version=6
// ╔══════════════════════════════════════════════════════════════════════════╗
// ║ TI-A STRATEGY — the indicator's signals run through TradingView's        ║
// ║ broker emulator, so the Strategy Tester can measure them.                ║
// ╚══════════════════════════════════════════════════════════════════════════╝
//
// READ THIS BEFORE READING THE STRATEGY TESTER TAB.
//
// This file exists so the signals can be COUNTED and INSPECTED, not so that a
// profit figure can be quoted. The repository claims no edge, and a green
// equity curve here would not establish one: a single instrument over a single
// history is statistically uninformative for an effect this small. The Python
// reference needs roughly 400 trades pooled across ~50 instruments before its
// own pre-registered test can even run (docs/00-PREREGISTRATION.md). Whatever
// number this tab shows you, it is one draw from a very wide distribution.
//
// Do not tune the inputs until the curve looks good. That is the failure mode
// docs/08-FAILURE-MODES.md ranks first.
//
// AND ONE MEASURED FACT ABOUT MODE B, THE DEFAULT. It was measured firing ~21
// times per 4000 bars on a SYNTHETIC MARTINGALE -- a market built to contain
// no edge whatsoever. Mode A fired 0-1 times on the same data. So a Mode B
// equity curve that slopes upward on one symbol is exactly what a gate with
// no edge also produces some of the time. Mode A is the gate that abstains on
// noise, and on 15 years of six ETFs it took 5 trades in total.
//
// EXECUTION MODEL — deliberately pessimistic, and matched to the Python model:
//   * signals are computed on CLOSED bars only (barstate.isconfirmed);
//   * orders are market orders, so the emulator fills them at the NEXT bar's
//     open. That is the Python model's execution_lag_bars = 1, not a fudge;
//   * the stop and target are placed as a bracket (strategy.exit) from the
//     levels computed on the signal bar, and never moved afterwards;
//   * when a bar's range spans both barriers the emulator's default is
//     ambiguous, so the bracket is submitted stop-first and the tester is
//     configured to resolve ties against the position;
//   * commission and slippage are ON by default and can be raised in
//     Properties. They cannot be turned off by accident.
//
// KNOWN DIFFERENCES from the Python backtest, all documented in
// pine/CHANGELOG_TRADINGVIEW.md: the emulator cannot see intrabar sequence on
// non-tick data, so a bar that touches both barriers is resolved by the
// tester's own rule rather than by the Python model's stop-wins convention;
// and the Python model charges a modelled market-impact term that no broker
// emulator represents.
//
// NOT INVESTMENT ADVICE. No profitability is claimed. Do not connect this to
// a live account.

strategy("TI-A Strategy", shorttitle="TI-A-S", overlay=true,
     max_bars_back=500, max_labels_count=100,
     pyramiding=0,
     initial_capital=100000,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     currency=currency.NONE,
     commission_type=strategy.commission.percent,
     commission_value=0.02,
     slippage=2,
     calc_on_every_tick=false,
     calc_on_order_fills=false,
     process_orders_on_close=false,
     close_entries_rule="ANY")

// ════════════════════════════════════════════════════════════════════════════
// INPUTS
// The first two groups are identical to the indicator's, so a setting that
// produced a signal on the chart produces the same signal here.
// ════════════════════════════════════════════════════════════════════════════
string MODE_A = "A: Frozen Research Model (not market-validated)"
string MODE_B = "B: Practical Observation Mode"

string modeIn      = input.string(MODE_B, "Operating mode", options=[MODE_B, MODE_A], group="Mode",
     tooltip="A evaluates the exported research model through its original, unrelaxed gate and will almost never trade. B is a chart-practical gate built from the same features.")
int    strictIn    = input.int(3, "Signal strictness (Mode B)", minval=1, maxval=5, group="Mode",
     tooltip="1 = loose (most signals) ... 5 = strict (fewest). Mode B only; Mode A ignores it.")

bool   allowLong   = input.bool(true,  "Allow long entries",  group="Direction")
bool   allowShort  = input.bool(true,  "Allow short entries", group="Direction")

bool   useHtfConf  = input.bool(true,  "Require higher-timeframe agreement", group="Filters")
bool   useSession  = input.bool(false, "Limit entries to a session (intraday charts only)", group="Filters")
string sessIn      = input.session("0930-1600", "Session", group="Filters")
int    cooldownIn  = input.int(10, "Cooldown bars after an exit", minval=0, maxval=200, group="Filters")
int    maxPer100In = input.int(6,  "Max entries per 100 bars", minval=1, maxval=50, group="Filters",
     tooltip="Mode A always uses the frozen model's own rate limit instead of this value.")

string STOP_ATR   = "ATR multiple"
string STOP_VOL   = "Forecast volatility (model default)"
string stopModeIn = input.string(STOP_VOL, "Stop / target basis", options=[STOP_VOL, STOP_ATR], group="Risk")
float  atrMultIn  = input.float(2.0, "ATR multiple for the stop", minval=0.25, maxval=10.0, step=0.25, group="Risk")
float  rrIn       = input.float(1.625, "Target : stop ratio (ATR mode)", minval=0.25, maxval=10.0, step=0.125, group="Risk",
     tooltip="1.625 reproduces the frozen model's 2.6 sigma target against its 1.6 sigma stop.")

// -- sizing ------------------------------------------------------------------
string SZ_RISK  = "Risk % of equity per trade"
string SZ_FIXED = "Fixed units per trade"
string sizeModeIn = input.string(SZ_RISK, "Position sizing", options=[SZ_RISK, SZ_FIXED], group="Sizing")
float  riskPctIn  = input.float(0.5, "Risk per trade (% of equity)", minval=0.01, maxval=5.0, step=0.05, group="Sizing",
     tooltip="Units are sized so that a stop-out loses this fraction of current equity. The Python model's own default is 0.5% (Config.risk_per_trade), capped at 2%.")
float  fixedQtyIn = input.float(1.0, "Fixed units", minval=0.000001, group="Sizing")
bool   wholeUnits = input.bool(true, "Round position size down to whole units", group="Sizing",
     tooltip="Turn this OFF for crypto and FX, where fractional size is normal. Leave it ON for stocks and futures.")
float  maxQtyPct  = input.float(100.0, "Cap notional at % of equity", minval=1.0, maxval=500.0, step=5.0, group="Sizing",
     tooltip="A hard cap so a tight stop cannot silently produce a leveraged position. Above 100% you are using margin.")

// -- date range --------------------------------------------------------------
bool startEnable = input.bool(false, "Limit the test to a date range", group="Date range")
int  startIn     = input.time(timestamp("01 Jan 2015 00:00 +0000"), "Start", group="Date range")
int  endIn       = input.time(timestamp("01 Jan 2035 00:00 +0000"), "End",   group="Date range")

bool showLevels = input.bool(true, "Show stop / target lines", group="Display")
bool showCard   = input.bool(true, "Show diagnostics card",    group="Display")
string cardSizeIn = input.string("Small", "Card text size", options=["Tiny", "Small", "Normal"], group="Display")

bool isModeA = modeIn == MODE_A

// ==== BEGIN SHARED CORE ====
// Everything between these markers is BYTE-IDENTICAL in TIA.pine and
// TIA_strategy.pine, and python/tests/test_pine_port.py fails the build if it
// ever stops being. The two scripts therefore cannot drift apart: whatever the
// indicator paints, the strategy trades. Only the code after the END marker
// differs -- the indicator draws, the strategy places orders.
//
// The core requires exactly two names from the host file: `isModeA` and
// `strictIn`. It defines everything else it uses.
// ══════════════════════════════════════════════════════════════════════════════


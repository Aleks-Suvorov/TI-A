// ════════════════════════════════════════════════════════════════════════════
// HELPERS
// Every parameter is explicitly typed so Pine never has to infer a qualifier,
// and every function is defined before its first use. No parameter name
// shadows a built-in namespace - a parameter called `str` silently breaks
// `str.split` for the rest of the script, and that bug shipped once already.
// ════════════════════════════════════════════════════════════════════════════
f_clip(float x, float lo, float hi) =>
    na(x) ? (lo + hi) * 0.5 : math.max(lo, math.min(hi, x))

f_safediv(float a, float b, float d) =>
    na(a) or na(b) or b == 0.0 ? d : a / b

f_slog(float x) =>
    // log with a guarded argument: never zero, never negative, never na.
    math.log(math.max(nz(x, 1.0e-12), 1.0e-12))

f_logistic(float x) =>
    1.0 / (1.0 + math.exp(-f_clip(x, -60.0, 60.0)))

f_tanh(float x) =>
    // Pine's math namespace has tan but NOT tanh, sinh or cosh. Calling
    // math.tanh compiles to CE10271 "Could not find function or function
    // reference" -- and far worse than a clean error, every downstream value
    // silently becomes type "unknown", so the real failure surfaces as a pile
    // of unrelated-looking CE10122 complaints about str.format arguments.
    // Clipping at +/-20 reaches +/-1 to full double precision.
    float z = f_clip(x, -20.0, 20.0)
    float ex = math.exp(2.0 * z)
    (ex - 1.0) / (ex + 1.0)

f_ewmaAlpha(float halflife) =>
    1.0 - math.pow(0.5, 1.0 / math.max(halflife, 0.5))

f_parseFloats(string csv) =>
    float[] out = array.new_float(0)
    if csv != ""
        string[] parts = str.split(csv, ",")
        // Size guard: Pine's `for a to b` counts DOWNWARD when b < a, so on an
        // empty array `0 to size-1` becomes `0 to -1` and reads index 0 out of
        // bounds instead of doing nothing.
        if array.size(parts) > 0
            for i = 0 to array.size(parts) - 1
                float v = str.tonumber(array.get(parts, i))
                array.push(out, na(v) ? 0.0 : v)
    out

f_normPpf(float p) =>
    // Acklam's rational approximation to the inverse normal CDF, |err| ~1e-9.
    float pp = f_clip(p, 1.0e-12, 1.0 - 1.0e-12)
    float res = 0.0
    if pp < 0.02425
        float q = math.sqrt(-2.0 * math.log(pp))
        res := (((((-0.007784894002430293 * q - 0.3223964580411365) * q - 2.400758277161838) * q - 2.549732539343734) * q + 4.374664141464968) * q + 2.938163982698783) / ((((0.007784695709041462 * q + 0.3224671290700398) * q + 2.445134137142996) * q + 3.754408661907416) * q + 1.0)
    else if pp > 0.97575
        float q = math.sqrt(-2.0 * math.log(1.0 - pp))
        res := -(((((-0.007784894002430293 * q - 0.3223964580411365) * q - 2.400758277161838) * q - 2.549732539343734) * q + 4.374664141464968) * q + 2.938163982698783) / ((((0.007784695709041462 * q + 0.3224671290700398) * q + 2.445134137142996) * q + 3.754408661907416) * q + 1.0)
    else
        float q = pp - 0.5
        float r = q * q
        res := (((((-39.69683028665376 * r + 220.9460984245205) * r - 275.9285104469687) * r + 138.3577518672690) * r - 30.66479806614716) * r + 2.506628277459239) * q / (((((-54.47609879822406 * r + 161.5858368580409) * r - 155.6989798598866) * r + 66.80131188771972) * r - 13.28068155288572) * r + 1.0)
    res

f_studentTPpf(float p, float dof) =>
    // Cornish-Fisher expansion, the same one the Python reference uses in
    // tia/engines/edgebook.py, so the two agree to ~1e-2 at the degrees of
    // freedom this model actually reaches.
    float res = 0.0
    if dof <= 2.0
        res := f_normPpf(p) * 4.0
    else
        float z  = f_normPpf(p)
        float z2 = z * z
        float z3 = z2 * z
        float z5 = z3 * z2
        float z7 = z5 * z2
        float g1 = (z3 + z) / 4.0
        float g2 = (5.0 * z5 + 16.0 * z3 + 3.0 * z) / 96.0
        float g3 = (3.0 * z7 + 19.0 * z5 + 17.0 * z3 - 15.0 * z) / 384.0
        res := z + g1 / dof + g2 / (dof * dof) + g3 / (dof * dof * dof)
    res

f_interp(float x, float[] xs, float[] ys) =>
    // numpy.interp semantics: linear between knots, clamped at both ends.
    int n = array.size(xs)
    float out = x
    if n >= 2 and array.size(ys) == n
        if x <= array.get(xs, 0)
            out := array.get(ys, 0)
        else if x >= array.get(xs, n - 1)
            out := array.get(ys, n - 1)
        else
            int hit = 1
            for k = 1 to n - 1
                if array.get(xs, k) >= x
                    hit := k
                    break
            float x0 = array.get(xs, hit - 1)
            float x1 = array.get(xs, hit)
            float y0 = array.get(ys, hit - 1)
            float y1 = array.get(ys, hit)
            float w  = f_safediv(x - x0, x1 - x0, 0.0)
            out := y0 + w * (y1 - y0)
    out

f_betaLogPdf(float x, float a, float b) =>
    // KERNEL ONLY. The ln B(a,b) normaliser is SUBTRACTED at the call site
    // from the exported FM_RG_LOGNORM table. docs/19-ADVERSARIAL-AUDIT.md D5:
    // omitting it tilted the posterior by up to 4.2 log units, and adding it
    // instead of subtracting doubled the damage. Do not "simplify" this.
    float xx = f_clip(x, 1.0e-6, 1.0 - 1.0e-6)
    (a - 1.0) * math.log(xx) + (b - 1.0) * math.log(1.0 - xx)

// ════════════════════════════════════════════════════════════════════════════
// FROZEN-MODEL ARRAYS
// Parsed once, lazily. The guard is "still empty?" rather than
// barstate.isfirst, so a chart that re-seeds its history heals itself.
// ════════════════════════════════════════════════════════════════════════════
var float[] DESIGN_A    = array.new_float(0)
var float[] DESIGN_B    = array.new_float(0)
var float[] DESIGN_LOGN = array.new_float(0)
var float[] PRECISION   = array.new_float(0)
var float[] ISO_X       = array.new_float(0)
var float[] ISO_Y       = array.new_float(0)
var float[] BUCKET_EDGE = array.new_float(0)
var float[] EDGE_MU     = array.new_float(0)
var float[] EDGE_SCALE  = array.new_float(0)
var float[] EDGE_DOF    = array.new_float(0)
var float[] EDGE_NEFF   = array.new_float(0)

if array.size(DESIGN_A) == 0
    DESIGN_A    := f_parseFloats(FM_RG_A)
    DESIGN_B    := f_parseFloats(FM_RG_B)
    DESIGN_LOGN := f_parseFloats(FM_RG_LOGNORM)
    PRECISION   := f_parseFloats(FM_ENG_PREC)
    ISO_X       := f_parseFloats(FM_ISO_X)
    ISO_Y       := f_parseFloats(FM_ISO_Y)
    BUCKET_EDGE := f_parseFloats(FM_EB_EDGES)
    EDGE_MU     := f_parseFloats(FM_EB_MU)
    EDGE_SCALE  := f_parseFloats(FM_EB_SCALE)
    EDGE_DOF    := f_parseFloats(FM_EB_DOF)
    EDGE_NEFF   := f_parseFloats(FM_EB_NEFF)

int  NREG  = 4
int  NFEAT = 8
int  NENG  = FM_ENG_M
bool modelOk  = array.size(DESIGN_A) == NREG * NFEAT and array.size(DESIGN_B) == NREG * NFEAT and array.size(DESIGN_LOGN) == NREG * NFEAT
bool fusionOk = array.size(PRECISION) == NENG * NENG
bool bookOk   = array.size(EDGE_MU) == NREG * FM_EB_NSETUP * FM_EB_NBUCKET

// ════════════════════════════════════════════════════════════════════════════
// L1 - FEATURE KERNEL (docs/01-THEORY.md 2-4)
// ════════════════════════════════════════════════════════════════════════════
int WARMUP_BARS = FM_RANK_N + 48

float ret  = na(close[1]) or close[1] <= 0.0 ? float(na) : math.log(close / close[1])
float absR = math.abs(nz(ret, 0.0))

// -- volatility: bipower (jump-robust), realised, Rogers-Satchell, EWMA, HAR --
float bpSum   = math.sum(absR * nz(absR[1], 0.0), FM_VOL_N)
float sigmaBp = math.sqrt(math.max(1.5707963267948966 * bpSum / float(FM_VOL_N - 1), 1.0e-16))
float rvMid   = math.sum(nz(ret * ret, 0.0), FM_VOL_N) / float(FM_VOL_N)
float sigmaRv = math.sqrt(math.max(rvMid, 1.0e-16))
float sigmaS  = math.sqrt(math.max(math.sum(nz(ret * ret, 0.0), FM_VOL_NS) / float(FM_VOL_NS), 1.0e-16))
float sigmaL  = math.sqrt(math.max(math.sum(nz(ret * ret, 0.0), FM_VOL_NL) / float(FM_VOL_NL), 1.0e-16))
float jumpShare = f_clip(f_safediv(sigmaRv * sigmaRv - sigmaBp * sigmaBp, sigmaRv * sigmaRv, 0.0), 0.0, 1.0)

float rsTerm  = f_slog(high / close) * f_slog(high / open) + f_slog(low / close) * f_slog(low / open)
float sigmaRs = math.sqrt(math.max(math.sum(rsTerm, FM_VOL_N) / float(FM_VOL_N), 1.0e-16))

var float ewVar = na
float alphaEw = f_ewmaAlpha(FM_EWMA_HL)
ewVar := na(ewVar) ? rvMid : alphaEw * nz(ret * ret, rvMid) + (1.0 - alphaEw) * ewVar
float sigmaEw = math.sqrt(math.max(nz(ewVar, rvMid), 1.0e-16))

// Geometric HAR blend. The weights are a THEORY parameter, deliberately never
// fitted. Falls back to the range scale on a dead tape - halted instrument,
// pegged rate - instead of dividing by a vanishing number.
float sigmaFcst = math.max(math.exp(FM_HAR_D * f_slog(sigmaS) + FM_HAR_W * f_slog(sigmaRv) + FM_HAR_M * f_slog(sigmaL)), 1.0e-8)
if sigmaS <= 1.001e-8 and sigmaRv <= 1.001e-8
    sigmaFcst := math.max(sigmaRs, 1.0e-6)

float volRank     = nz(ta.percentrank(f_slog(sigmaFcst), FM_RANK_N), 50.0) / 100.0
float compression = 1.0 - nz(ta.percentrank(f_safediv(sigmaS, sigmaL, 1.0), FM_RANK_N), 50.0) / 100.0
float volRatio    = f_safediv(sigmaEw, sigmaFcst, 1.0)
float rangeSigma  = f_clip(f_safediv(f_slog(high / low), sigmaFcst, 1.3), 0.0, 8.0)
float atrVal      = ta.atr(14)

// -- liquidity: participation, LADR, absorption (docs/01-THEORY.md 3.1) -------
// Instruments with no volume feed - many FX and index symbols - degrade
// gracefully: the liquidity features go neutral and the card says so, rather
// than the script dying or silently pretending volume exists.
float volRaw = nz(volume, 0.0)
var bool hasVolume = false
hasVolume := hasVolume or volRaw > 0.0
float dollarVol = hasVolume ? (high + low + close) / 3.0 * volRaw : 1.0
float medVol    = ta.median(dollarVol, FM_PART_N)
float participation = hasVolume ? f_clip(f_safediv(dollarVol, math.max(medVol, 1.0e-12), 1.0), 0.0, 50.0) : 1.0
float partRank  = hasVolume ? nz(ta.percentrank(participation, FM_RANK_N), 50.0) / 100.0 : 0.5

float dNorm    = f_safediv(nz(ret, 0.0), sigmaBp, 0.0)
float adNorm   = math.abs(dNorm)
float ladrAbs  = f_safediv(adNorm, math.pow(math.max(participation, 1.0e-12), FM_PSI), 0.0)
float ladr     = nz(ret, 0.0) >= 0.0 ? ladrAbs : -ladrAbs
float ladrRank = nz(ta.percentrank(ladrAbs, FM_RANK_N), 50.0) / 100.0
float absorption = f_safediv(participation, adNorm + 1.0e-6, 0.0)
float absRank    = hasVolume ? nz(ta.percentrank(math.log(1.0 + absorption), FM_RANK_N), 50.0) / 100.0 : 0.5

float clv    = high - low <= 0.0 ? 0.0 : (2.0 * close - high - low) / (high - low)
float clvEma = ta.ema(clv, FM_CLV_HL)

// -- Kalman local linear trend (docs/01-THEORY.md 4.1); forward pass only -----
var float kLev = na
var float kSlp = 0.0
var float kP00 = na
var float kP01 = 0.0
var float kP11 = na
float s2   = sigmaFcst * sigmaFcst
float logC = f_slog(close)
if na(kLev)
    kLev := logC
    kP00 := 100.0 * s2
    kP11 := s2
else
    kLev := kLev + kSlp
    float p00 = kP00 + 2.0 * kP01 + kP11 + FM_KAL_SNR * s2
    float p01 = kP01 + kP11
    float p11 = kP11 + FM_KAL_SNR_SLOPE * s2
    float innovVar = p00 + s2
    float k0 = f_safediv(p00, innovVar, 0.0)
    float k1 = f_safediv(p01, innovVar, 0.0)
    float resid = logC - kLev
    kLev := kLev + k0 * resid
    kSlp := kSlp + k1 * resid
    kP00 := math.max(p00 - k0 * p00, 1.0e-18)
    kP01 := p01 - k0 * p01
    kP11 := math.max(p11 - k1 * p01, 1.0e-18)
float slopeT = bar_index < 5 ? float(na) : f_safediv(kSlp, math.sqrt(kP11), float(na))

// -- Lo-MacKinlay variance ratio, homoskedastic form, frozen null scale ------
// The heteroskedasticity-robust theta(q) correction is a documented
// Python-only refinement (docs/11-PINE-PLAN.md 3) and is this port's largest
// known approximation. The four lags are inlined because Pine requires a
// compile-time constant length for math.sum, so FM_VR_LAGS cannot drive them.
float var1 = ta.variance(nz(ret, 0.0), FM_VR_N)
f_vrterm(float varq, float q) =>
    float vr = f_safediv(varq / q, var1, 1.0)
    (vr - 1.0) * math.sqrt(float(FM_VR_N) / (2.0 * (q - 1.0)))
float vrZ2  = f_vrterm(ta.variance(math.sum(nz(ret, 0.0), 2),  FM_VR_N), 2.0)
float vrZ4  = f_vrterm(ta.variance(math.sum(nz(ret, 0.0), 4),  FM_VR_N), 4.0)
float vrZ8  = f_vrterm(ta.variance(math.sum(nz(ret, 0.0), 8),  FM_VR_N), 8.0)
float vrZ16 = f_vrterm(ta.variance(math.sum(nz(ret, 0.0), 16), FM_VR_N), 16.0)
float vrZ   = (vrZ2 + vrZ4 + vrZ8 + vrZ16) / 4.0
float vrRank = nz(ta.percentrank(nz(vrZ, 0.0), FM_RANK_N), 50.0) / 100.0

float efficiency = f_clip(math.abs(f_safediv(math.sum(nz(ret, 0.0), FM_EFF_N), math.sum(absR, FM_EFF_N), 0.0)), 0.0, 1.0)

// -- permutation entropy, order 3, O(1) per bar via ring-buffered counts ------
// The previous build re-read 360 bars of history through a dynamic index on
// every bar: a runtime-error and performance trap. Same statistic, var arrays.
var int[] peCounts = array.new_int(6, 0)
var int[] peRing   = array.new_int(FM_PE_N, -1)
var int   peHead   = 0
var int   peFilled = 0
float c0  = close
float c1  = nz(close[1], close)
float c2n = nz(close[2], close)
int pat = c2n < c1 ? (c1 < c0 ? 0 : c2n < c0 ? 1 : 2) : c1 < c0 ? (c2n < c0 ? 3 : 4) : 5
if bar_index >= 2
    int evict = array.get(peRing, peHead)
    if evict >= 0
        array.set(peCounts, evict, math.max(array.get(peCounts, evict) - 1, 0))
    array.set(peRing, peHead, pat)
    array.set(peCounts, pat, array.get(peCounts, pat) + 1)
    peHead   := (peHead + 1) % FM_PE_N
    peFilled := math.min(peFilled + 1, FM_PE_N)
float permEntropy = 0.5
if peFilled >= 20
    float peSum = 0.0
    for k = 0 to 5
        float pk = float(array.get(peCounts, k)) / float(peFilled)
        peSum += pk > 0.0 ? -pk * math.log(pk) : 0.0
    permEntropy := f_clip(peSum / math.log(6.0), 0.0, 1.0)

// -- structure: pivots exist only after their confirmation delay --------------
float ph = ta.pivothigh(high, FM_PIV_CONFIRM, FM_PIV_CONFIRM)
float pl = ta.pivotlow(low,  FM_PIV_CONFIRM, FM_PIV_CONFIRM)
var float pivotHigh    = na
var float pivotLow     = na
var int   pivotHighBar = 0
var int   pivotLowBar  = 0
if not na(ph)
    pivotHigh    := ph
    pivotHighBar := bar_index - FM_PIV_CONFIRM
if not na(pl)
    pivotLow    := pl
    pivotLowBar := bar_index - FM_PIV_CONFIRM
float rangePos = na(pivotHigh) or na(pivotLow) or pivotHigh <= pivotLow ? float(na) : f_clip((close - pivotLow) / (pivotHigh - pivotLow), 0.0, 1.0)

// -- higher timeframe WITHOUT request.security -------------------------------
// The previous build passed mutable-variable expressions to request.security
// (which Pine rejects outright) and built timeframe strings that were invalid
// on weekly charts. This aggregates FM_HTF_MULT closed chart bars into one HTF
// bar in-script - the same causal aggregator the Python reference uses - so it
// behaves identically on every chart resolution and cannot repaint: HTF values
// update only when an HTF bar COMPLETES and hold constant in between.
var int   htfCount     = 0
var float htfHAcc      = na
var float htfLAcc      = na
var float htfPrevClose = na
var float htfEwVar     = na
var float hkLev = na
var float hkSlp = 0.0
var float hkP00 = na
var float hkP01 = 0.0
var float hkP11 = na
var float htfSlopeT   = na
var float htfRangePos = na
var float[] htfHighs = array.new_float(0)
var float[] htfLows  = array.new_float(0)

htfHAcc := na(htfHAcc) ? high : math.max(htfHAcc, high)
htfLAcc := na(htfLAcc) ? low  : math.min(htfLAcc, low)
htfCount += 1
if htfCount >= FM_HTF_MULT
    float hC   = close
    float hRet = na(htfPrevClose) or htfPrevClose <= 0.0 ? float(na) : math.log(hC / htfPrevClose)
    htfEwVar := na(hRet) ? htfEwVar : na(htfEwVar) ? hRet * hRet : 0.1 * hRet * hRet + 0.9 * htfEwVar
    float hSig = math.sqrt(math.max(nz(htfEwVar, 1.0e-8), 1.0e-10))
    float hs2  = hSig * hSig
    float hLog = f_slog(hC)
    if na(hkLev)
        hkLev := hLog
        hkP00 := 100.0 * hs2
        hkP11 := hs2
    else
        hkLev := hkLev + hkSlp
        float hp00 = hkP00 + 2.0 * hkP01 + hkP11 + FM_KAL_SNR * hs2
        float hp01 = hkP01 + hkP11
        float hp11 = hkP11 + FM_KAL_SNR_SLOPE * hs2
        float hiv  = hp00 + hs2
        float hk0  = f_safediv(hp00, hiv, 0.0)
        float hk1  = f_safediv(hp01, hiv, 0.0)
        float hres = hLog - hkLev
        hkLev := hkLev + hk0 * hres
        hkSlp := hkSlp + hk1 * hres
        hkP00 := math.max(hp00 - hk0 * hp00, 1.0e-18)
        hkP01 := hp01 - hk0 * hp01
        hkP11 := math.max(hp11 - hk1 * hp01, 1.0e-18)
        htfSlopeT := f_safediv(hkSlp, math.sqrt(hkP11), float(na))
    array.push(htfHighs, nz(htfHAcc, high))
    array.push(htfLows,  nz(htfLAcc, low))
    if array.size(htfHighs) > 20
        array.shift(htfHighs)
        array.shift(htfLows)
    if array.size(htfHighs) >= 5
        float hHH = array.max(htfHighs)
        float hLL = array.min(htfLows)
        htfRangePos := hHH <= hLL ? float(na) : f_clip((hC - hLL) / (hHH - hLL), 0.0, 1.0)
    htfPrevClose := hC
    htfCount := 0
    htfHAcc  := na
    htfLAcc  := na

// -- sweep-and-fail (docs/01-THEORY.md 3.2): knowable only AFTER the reclaim --
var int   sweepDir   = 0
var int   sweepAge   = 999
var float sweepLvlLo = na
var float sweepLvlHi = na
var int   pendLoAge  = 999
var int   pendHiAge  = 999
sweepAge  += 1
pendLoAge += 1
pendHiAge += 1
bool heavy = partRank >= FM_SWEEP_PARTMIN
if pendLoAge <= FM_SWEEP_MAXBARS and not na(sweepLvlLo) and close > sweepLvlLo
    sweepDir  := 1
    sweepAge  := 0
    pendLoAge := 999
if pendHiAge <= FM_SWEEP_MAXBARS and not na(sweepLvlHi) and close < sweepLvlHi
    sweepDir  := -1
    sweepAge  := 0
    pendHiAge := 999
if heavy and not na(pivotLow) and low < pivotLow and f_safediv(f_slog(pivotLow / math.max(low, 1.0e-12)), sigmaBp, 0.0) >= FM_SWEEP_MINPEN and (clv > 0.0 or absRank >= 0.6)
    pendLoAge  := 0
    sweepLvlLo := pivotLow
if heavy and not na(pivotHigh) and high > pivotHigh and f_safediv(f_slog(high / pivotHigh), sigmaBp, 0.0) >= FM_SWEEP_MINPEN and (clv < 0.0 or absRank >= 0.6)
    pendHiAge  := 0
    sweepLvlHi := pivotHigh

bool featuresValid = bar_index >= WARMUP_BARS and modelOk

// ════════════════════════════════════════════════════════════════════════════
// L2a - REGIME POSTERIOR (docs/01-THEORY.md 5)
// Forward recursion only; the smoother would repaint every historical label.
// Zero parameters fitted to returns: Beta(1,1) is exactly uniform, so "this
// regime makes no claim about this feature" lives inside the same family and
// contributes a likelihood factor of exactly 1.
// ════════════════════════════════════════════════════════════════════════════
var float[] logAlpha  = array.new_float(4, -1.3862943611198906)
var float[] refPost   = array.new_float(4, 0.25)
var float[] posterior = array.new_float(4, 0.25)
float hazard    = 1.0
int   domRegime = 3
float refAlpha  = f_ewmaAlpha(FM_RG_HAZ_HL)

if featuresValid
    float[] feat = array.new_float(0)
    array.push(feat, volRank)
    array.push(feat, vrRank)
    array.push(feat, ladrRank)
    array.push(feat, absRank)
    array.push(feat, partRank)
    array.push(feat, permEntropy)
    array.push(feat, jumpShare)
    array.push(feat, efficiency)
    int usable = 0
    for j = 0 to NFEAT - 1
        if not na(array.get(feat, j))
            usable += 1
    if usable >= FM_RG_MIN_FEAT
        float[] logLik = array.new_float(4, 0.0)
        for k = 0 to NREG - 1
            float acc = 0.0
            for j = 0 to NFEAT - 1
                float v = array.get(feat, j)
                if not na(v)
                    acc += f_betaLogPdf(v, array.get(DESIGN_A, k * NFEAT + j), array.get(DESIGN_B, k * NFEAT + j)) - array.get(DESIGN_LOGN, k * NFEAT + j)
            array.set(logLik, k, FM_RG_TEMPER * acc)
        float[] newLog = array.new_float(4, 0.0)
        for k = 0 to NREG - 1
            float mx = -1.0e18
            for j = 0 to NREG - 1
                mx := math.max(mx, array.get(logAlpha, j) + (j == k ? FM_RG_LOG_STAY : FM_RG_LOG_SWITCH))
            float sacc = 0.0
            for j = 0 to NREG - 1
                sacc += math.exp(array.get(logAlpha, j) + (j == k ? FM_RG_LOG_STAY : FM_RG_LOG_SWITCH) - mx)
            array.set(newLog, k, mx + math.log(math.max(sacc, 1.0e-300)) + array.get(logLik, k))
        float mx2 = -1.0e18
        for k = 0 to NREG - 1
            mx2 := math.max(mx2, array.get(newLog, k))
        float tot = 0.0
        for k = 0 to NREG - 1
            tot += math.exp(array.get(newLog, k) - mx2)
        float lnorm = mx2 + math.log(math.max(tot, 1.0e-300))
        float drift = 0.0
        float maxP  = 0.0
        for k = 0 to NREG - 1
            array.set(logAlpha, k, array.get(newLog, k) - lnorm)
            float pk = math.exp(array.get(logAlpha, k))
            array.set(posterior, k, pk)
            float rk = (1.0 - refAlpha) * array.get(refPost, k) + refAlpha * pk
            array.set(refPost, k, rk)
            drift += math.abs(pk - rk)
            if pk > maxP
                maxP := pk
                domRegime := k
        // Either a posterior in motion or one that never committed is reason
        // enough to stand aside; the max is the conservative reading.
        hazard := math.max(0.5 * drift, 1.0 - maxP)

float pTrend  = array.get(posterior, 0)
float pRevert = array.get(posterior, 1)
float pStress = array.get(posterior, 2)
float pQuiet  = array.get(posterior, 3)
float regimeCommit = math.max(math.max(pTrend, pRevert), math.max(pStress, pQuiet))

// ════════════════════════════════════════════════════════════════════════════
// L2b - ENGINE SCORES (identical in both modes; docs/03-ENGINES.md)
// Each engine emits a score in [-1, 1] and a reliability in [0, 1]. The
// reliability is what the pooling weights, and it is where regime conditioning
// bites: a mean-reversion engine is not merely wrong in a trending regime, it
// is unreliable, and those are different things.
// ════════════════════════════════════════════════════════════════════════════
float regScore = f_clip(0.5 * (pTrend * f_tanh(nz(slopeT, 0.0) / 2.0) + pRevert * (0.5 - nz(rangePos, 0.5)) * 2.0), -1.0, 1.0)
float regRel   = f_clip(regimeCommit * (1.0 - hazard), 0.0, 1.0)

float trAgree = (close > nz(close[5], close) ? 1.0 : -1.0) + (close > nz(close[22], close) ? 1.0 : -1.0) + (close > nz(close[66], close) ? 1.0 : -1.0)
float trScore = f_clip(0.45 * f_tanh(nz(slopeT, 0.0) / 2.0) + 0.25 * trAgree / 3.0 + 0.30 * f_tanh(nz(htfSlopeT, 0.0) / 2.0), -1.0, 1.0)
float persist = f_clip(0.5 + nz(vrZ, 0.0) / 4.0, 0.0, 1.0)
bool  tfAgreeOk = na(htfSlopeT) or na(slopeT) or (htfSlopeT >= 0.0) == (slopeT >= 0.0)
float trRel   = f_clip((0.25 + 0.75 * pTrend) * (0.15 + 0.85 * persist) * (0.45 + 0.55 * efficiency) * (tfAgreeOk ? 1.0 : 0.45) * (1.0 - 0.6 * pRevert), 0.0, 1.0)

float moStrength = math.max(0.0, 2.0 * ladrRank - 1.0)
float moDir      = ladr > 0.0 ? 1.0 : ladr < 0.0 ? -1.0 : 0.0
float moScore    = f_clip(0.625 * moDir * moStrength + 0.25 * f_clip(clvEma, -1.0, 1.0), -1.0, 1.0)
float moRel      = f_clip((0.20 + 0.80 * moStrength) * (0.35 + 0.65 * pTrend) * (1.0 - 0.5 * pRevert) * (1.0 - 0.7 * pQuiet) * f_clip(1.0 - 0.5 * jumpShare, 0.4, 1.0), 0.0, 1.0)

float sweepScore = sweepAge <= 4 and sweepDir != 0 ? float(sweepDir) * 0.6 * (1.0 - float(sweepAge) / 5.0) : 0.0
float edgeDist   = na(rangePos) ? 0.0 : math.abs(rangePos - 0.5) * 2.0
bool  absorbing  = hasVolume and absRank > 0.65 and edgeDist > 0.5
float absorbSc   = absorbing ? -f_clip((absRank - 0.65) / 0.35 * edgeDist, 0.0, 1.0) * (nz(rangePos, 0.5) > 0.5 ? 1.0 : -1.0) : 0.0
float liqScore   = sweepScore != 0.0 and absorbSc != 0.0 ? 0.7 * sweepScore + 0.3 * absorbSc : sweepScore + absorbSc
bool  liqEvent   = sweepScore != 0.0 or absorbing
float liqRel     = liqEvent ? f_clip((0.30 + 0.70 * math.abs(liqScore)) * (0.40 + 0.60 * (pRevert + 0.6 * pStress)) * (1.0 - 0.35 * pTrend), 0.0, 1.0) : hasVolume ? 0.35 : 0.10

float volFav   = volRank >= 0.25 and volRank <= 0.80 ? 1.0 : f_clip(1.0 - 2.0 * (volRank < 0.25 ? (0.25 - volRank) / 0.55 : (volRank - 0.80) / 0.55), -1.0, 1.0)
float volScore = volRatio > 1.15 and math.abs(dNorm) > 0.5 ? f_clip(0.35 * f_tanh(dNorm / 2.0), -0.4, 0.4) : 0.0
float volRel   = f_clip((0.35 + 0.45 * f_clip((volFav + 1.0) / 2.0, 0.0, 1.0)) * (1.0 - 0.4 * pStress), 0.0, 1.0)

float stPos    = na(rangePos) ? 0.0 : 2.0 * rangePos - 1.0
float wT       = pTrend + 1.0e-9
float wR       = pRevert + 1.0e-9
float stScore0 = (wT * stPos + wR * -stPos) / (wT + wR)
float stScore  = na(htfRangePos) ? stScore0 : f_clip(0.7 * stScore0 + 0.3 * (wT - wR) * (2.0 * htfRangePos - 1.0) / (wT + wR), -1.0, 1.0)
float stDecis  = f_safediv(math.abs(pTrend - pRevert), pTrend + pRevert, 0.0)
float stAgeMax = float(math.max(bar_index - pivotHighBar, bar_index - pivotLowBar))
float stStale  = f_clip(1.0 - (stAgeMax - 20.0) / 120.0, 0.25, 1.0)
float stRel    = na(rangePos) ? 0.0 : f_clip((0.25 + 0.75 * math.abs(stPos)) * (0.35 + 0.65 * stDecis) * stStale, 0.0, 1.0)

// The behavioural engine's live inputs - dealer gamma, positioning surveys -
// are not available inside TradingView. It is kept so the engine indices match
// the exported precision matrix, and it abstains: a score of 0 contributes
// exactly zero evidence while the matrix stays conformable.
float bhScore = 0.0
float bhRel   = 0.9

// ════════════════════════════════════════════════════════════════════════════
// L3 - CALOP FUSION (docs/01-THEORY.md 6)
// Summing log-odds - which is what every "confluence score" implicitly does -
// is correct Bayes only under conditional independence. Seven engines built on
// overlapping windows of one price series are nowhere near independent, so the
// pooling uses the exported precision matrix:
//     L = 1' M l,   EBE = 1' M 1,   M = D^0.5 C^-1 D^0.5
// ════════════════════════════════════════════════════════════════════════════
f_evidence(float s) =>
    float x = f_clip(s, -FM_FUSE_CLAMP, FM_FUSE_CLAMP)
    math.log((1.0 + x) / (1.0 - x))

var float[] scoreArr = array.new_float(7, 0.0)
var float[] relArr   = array.new_float(7, 0.0)
array.set(scoreArr, 0, regScore)
array.set(scoreArr, 1, trScore)
array.set(scoreArr, 2, moScore)
array.set(scoreArr, 3, liqScore)
array.set(scoreArr, 4, volScore)
array.set(scoreArr, 5, stScore)
array.set(scoreArr, 6, bhScore)
array.set(relArr, 0, regRel)
array.set(relArr, 1, trRel)
array.set(relArr, 2, moRel)
array.set(relArr, 3, liqRel)
array.set(relArr, 4, volRel)
array.set(relArr, 5, stRel)
array.set(relArr, 6, bhRel)

float logOdds  = 0.0
float ebeTotal = 0.0
if featuresValid and fusionOk
    for i = 0 to NENG - 1
        float di = math.sqrt(math.max(array.get(relArr, i), 0.0))
        for j = 0 to NENG - 1
            float dj  = math.sqrt(math.max(array.get(relArr, j), 0.0))
            float pij = array.get(PRECISION, i * NENG + j)
            logOdds  += di * pij * dj * f_evidence(array.get(scoreArr, j))
            ebeTotal += di * pij * dj

int direction = logOdds > 0.0 ? 1 : logOdds < 0.0 ? -1 : 0

// Aligned breadth: how many *independent* opinions actually point this way.
// Seven mildly bullish but duplicated engines must not read as seven.
float ebeAligned = 0.0
if featuresValid and fusionOk and direction != 0
    for i = 0 to NENG - 1
        float si = array.get(scoreArr, i)
        float ri = array.get(relArr, i)
        if ri > 0.0 and math.abs(si) * ri > FM_FUSE_ALIGNEPS and (si > 0.0 ? 1 : -1) == direction
            float di = math.sqrt(ri)
            for j = 0 to NENG - 1
                float sj = array.get(scoreArr, j)
                float rj = array.get(relArr, j)
                if rj > 0.0 and math.abs(sj) * rj > FM_FUSE_ALIGNEPS and (sj > 0.0 ? 1 : -1) == direction
                    ebeAligned += di * array.get(PRECISION, i * NENG + j) * math.sqrt(rj)

// MacKay probit correction: confidence shrinks toward 50% when the evidence is
// narrow. A reported 90% has to be both strong AND broad.
float varL   = FM_FUSE_SD * FM_FUSE_SD * math.max(ebeTotal, 1.0e-9)
float kap    = 1.0 / math.sqrt(1.0 + 0.39269908169872414 * FM_FUSE_T * FM_FUSE_T * varL)
float pUpRaw = f_logistic((FM_FUSE_T * logOdds + FM_FUSE_B) * kap)
float pUp    = FM_ISO_ON and array.size(ISO_X) >= 2 ? f_interp(pUpRaw, ISO_X, ISO_Y) : pUpRaw
float pSuccess = direction >= 0 ? pUp : 1.0 - pUp

// ════════════════════════════════════════════════════════════════════════════
// MODE A GATE - the frozen Edge Book's lower credible bound, minus costs.
// Selectivity here is a CONSEQUENCE of the rule, not a threshold anyone chose,
// and it is not relaxed to make the chart look busier.
// ════════════════════════════════════════════════════════════════════════════
// setups: 0 continuation, 1 sweep_reversal, 2 compression_break, 3 range_fade
int   setupIdx = sweepAge <= 4 and sweepDir != 0 ? 1 : compression > 0.7 and volRatio > 1.1 ? 2 : pRevert > pTrend ? 3 : 0
float absL = math.abs(logOdds)
int   bucketIdx = 0
// The size guard is load-bearing, not defensive noise. Pine's `for a to b`
// counts DOWNWARD when b < a, so on an empty array `0 to array.size(x) - 1`
// becomes `0 to -1` and iterates k = 0, then k = -1 -- an out-of-bounds
// array.get and a runtime error, where the intent was to do nothing at all.
if array.size(BUCKET_EDGE) > 0
    for k = 0 to array.size(BUCKET_EDGE) - 1
        if absL >= array.get(BUCKET_EDGE, k)
            bucketIdx += 1
bucketIdx := math.min(bucketIdx, FM_EB_NBUCKET - 1)
int  cellIdx = (domRegime * FM_EB_NSETUP + setupIdx) * FM_EB_NBUCKET + bucketIdx
bool cellOk  = bookOk and cellIdx >= 0 and cellIdx < array.size(EDGE_MU)
float edgeMu   = cellOk ? array.get(EDGE_MU, cellIdx) : 0.0
float edgeScl  = cellOk ? math.max(array.get(EDGE_SCALE, cellIdx), 1.0e-6) : 0.25
float edgeDof  = cellOk ? math.max(array.get(EDGE_DOF, cellIdx), 2.1) : 6.0
float edgeNeff = cellOk ? array.get(EDGE_NEFF, cellIdx) : 0.0
float edgeLcb  = edgeMu + f_studentTPpf(FM_EB_Q, edgeDof) * edgeScl

// Costs in units of forecast volatility - the same denominator as the edge.
// A round trip that costs more than the edge is the ordinary case, which is
// why abstention is the primary output rather than a defensive afterthought.
float kStress   = 1.0 + 1.5 * pStress
float spreadRel = FM_COST_SFALL
float halfSpSig = math.min(f_safediv(0.5 * spreadRel, sigmaFcst, 1.0e9), 1.0e9)
if halfSpSig > FM_COST_MAXHS
    halfSpSig := 1.0e9
float roundTrip = 2.0 * (kStress * halfSpSig + kStress * FM_COST_ETA * math.pow(FM_COST_Q, FM_PSI) + kStress * FM_COST_PHI * math.min(rangeSigma, 5.0) + f_safediv(FM_COST_FEE_BPS * 1.0e-4, sigmaFcst, 0.0))
float evLcbNet = edgeLcb - roundTrip

// ════════════════════════════════════════════════════════════════════════════
// MODE B GATE - practical observation: same engines, reliability-weighted,
// with adjustable strictness. No claim of validation attaches to this.
// ════════════════════════════════════════════════════════════════════════════
float bScoreMin = strictIn == 1 ? 0.25 : strictIn == 2 ? 0.35 : strictIn == 3 ? 0.45 : strictIn == 4 ? 0.55 : 0.65
float bQuietMax = strictIn <= 2 ? 0.70 : strictIn == 3 ? 0.60 : 0.50
float bHazMax   = strictIn <= 2 ? 0.55 : strictIn == 3 ? 0.45 : 0.40
float bBreadth  = strictIn <= 2 ? 0.60 : strictIn == 3 ? 0.90 : 1.20
float wSum   = regRel + trRel + moRel + liqRel + volRel + stRel + 1.0e-9
float bScore = f_clip((regRel * regScore + trRel * trScore + moRel * moScore + liqRel * liqScore + volRel * volScore + stRel * stScore) / wSum * 2.0, -1.0, 1.0)
int   bDir   = bScore > 0.0 ? 1 : bScore < 0.0 ? -1 : 0
float bConf  = 50.0 + 45.0 * math.abs(bScore) * regimeCommit

// ==== END SHARED CORE ====

// ════════════════════════════════════════════════════════════════════════════
// POSITION STATE MACHINE
// One position at a time. Every mutation is gated on barstate.isconfirmed, so
// nothing flickers intrabar and nothing already printed is ever revised.
// ════════════════════════════════════════════════════════════════════════════
var int   posState    = 0
var float entryPx     = na
var float stopPx      = na
var float targetPx    = na
var int   barsHeld    = 0
var int   lastExitBar = -99999
var int[] entryBars   = array.new_int(0)

bool confirmed = barstate.isconfirmed
bool inSession = not useSession or not timeframe.isintraday or not na(time(timeframe.period, sessIn))

int posBefore = posState
if confirmed and posState != 0
    barsHeld += 1

// -- resting barriers, evaluated on the confirmed bar's range -----------------
// Pessimistic tie-break: the stop wins a same-bar tie, and a gap through the
// stop is treated as filled at the (worse) open. Bar data cannot resolve
// intrabar sequence, so the ambiguity is always resolved against us.
bool exitStop   = false
bool exitTarget = false
if confirmed and posState == 1 and not na(stopPx)
    if low <= stopPx
        exitStop := true
    else if high >= targetPx
        exitTarget := true
if confirmed and posState == -1 and not na(stopPx)
    if high >= stopPx
        exitStop := true
    else if low <= targetPx
        exitTarget := true

// -- discretionary exits decided at the close --------------------------------
int  propDir0 = isModeA ? direction : bDir
bool timeExit = confirmed and posState != 0 and not exitStop and not exitTarget and barsHeld >= FM_MAX_HOLD
bool revExit  = confirmed and posState != 0 and not exitStop and not exitTarget and not timeExit and barsHeld >= FM_MIN_HOLD and propDir0 == -posState and (isModeA ? pSuccess >= FM_GATE_PEXIT : math.abs(bScore) >= bScoreMin * 0.6)

bool   exitNow = exitStop or exitTarget or timeExit or revExit
string exitWhy = exitStop ? "stop hit" : exitTarget ? "target hit" : timeExit ? "time exit at " + str.tostring(FM_MAX_HOLD) + " bars" : revExit ? "reversal signal" : ""
// One-word form for the chart label. The long form above goes in the alert,
// where there is room for it and no layout to disturb.
string exitShort = exitStop ? "stop" : exitTarget ? "target" : timeExit ? "time" : revExit ? "reversal" : ""
float  exitPx  = exitStop ? (posBefore == 1 ? math.min(open, stopPx) : math.max(open, stopPx)) : exitTarget ? targetPx : close

bool sellSig  = exitNow and posBefore == 1
bool coverSig = exitNow and posBefore == -1

var int heldAtExit = 0
if exitNow
    heldAtExit  := barsHeld
    posState    := 0
    barsHeld    := 0
    lastExitBar := bar_index

// -- rate limiter over a rolling 100 bars ------------------------------------
while array.size(entryBars) > 0 and bar_index - array.get(entryBars, 0) > 100
    array.shift(entryBars)
int  maxPer100  = isModeA ? FM_GATE_RATE : maxPer100In
bool rateOk     = array.size(entryBars) < maxPer100
bool cooldownOk = bar_index - lastExitBar >= math.max(cooldownIn, 1)

// ════════════════════════════════════════════════════════════════════════════
// THE GATE - twelve conjunctive conditions. Every one is counted, and the
// FIRST failure is what the card reports, so "why not?" always has an answer.
// ════════════════════════════════════════════════════════════════════════════
int    gatesPassed = 0
int    gatesTotal  = 0
string vetoText    = ""

int   propDir  = propDir0
float propConf = isModeA ? pSuccess * 100.0 : bConf

bool g1 = featuresValid
gatesTotal += 1
if g1
    gatesPassed += 1
else if vetoText == ""
    vetoText := modelOk ? "warming up, " + str.tostring(math.max(WARMUP_BARS - bar_index, 0)) + " bars left" : "model failed to load"

bool g2 = propDir != 0
gatesTotal += 1
if g2
    gatesPassed += 1
else if vetoText == ""
    vetoText := "no directional evidence"

bool g3 = propDir > 0 ? allowLong : propDir < 0 ? allowShort : false
gatesTotal += 1
if g3
    gatesPassed += 1
else if vetoText == "" and g2
    vetoText := propDir > 0 ? "long entries disabled" : "short entries disabled"

bool g4 = isModeA ? domRegime != 3 : pQuiet < bQuietMax
gatesTotal += 1
if g4
    gatesPassed += 1
else if vetoText == ""
    vetoText := "quiet regime, p=" + str.tostring(pQuiet, "#.##")

bool g5 = hazard <= (isModeA ? FM_RG_HAZ_MAX : bHazMax)
gatesTotal += 1
if g5
    gatesPassed += 1
else if vetoText == ""
    vetoText := "regime shifting, hazard " + str.tostring(hazard, "#.##")

bool g6 = isModeA ? evLcbNet > FM_GATE_EVLCB : math.abs(bScore) >= bScoreMin
gatesTotal += 1
if g6
    gatesPassed += 1
else if vetoText == ""
    vetoText := isModeA ? "edge-cost " + str.tostring(evLcbNet, "#.###") + ", need > " + str.tostring(FM_GATE_EVLCB, "#.##") : "score " + str.tostring(math.abs(bScore), "#.##") + ", need " + str.tostring(bScoreMin, "#.##")

bool g7 = isModeA ? pSuccess >= FM_GATE_PMIN : bConf >= 55.0
gatesTotal += 1
if g7
    gatesPassed += 1
else if vetoText == ""
    vetoText := "confidence " + str.tostring(propConf, "#.#") + "% too low"

bool g8 = ebeAligned >= (isModeA ? FM_GATE_EBEMIN : bBreadth)
gatesTotal += 1
if g8
    gatesPassed += 1
else if vetoText == ""
    vetoText := "breadth " + str.tostring(ebeAligned, "#.##") + ", need " + str.tostring(isModeA ? FM_GATE_EBEMIN : bBreadth, "#.##")

bool g9 = not useHtfConf or na(htfSlopeT) or propDir == 0 or (propDir > 0 ? htfSlopeT > -0.5 : htfSlopeT < 0.5)
gatesTotal += 1
if g9
    gatesPassed += 1
else if vetoText == ""
    vetoText := "higher timeframe disagrees"

bool g10 = inSession
gatesTotal += 1
if g10
    gatesPassed += 1
else if vetoText == ""
    vetoText := "outside the session filter"

bool g11 = rateOk and cooldownOk
gatesTotal += 1
if g11
    gatesPassed += 1
else if vetoText == ""
    vetoText := not rateOk ? "rate limit, " + str.tostring(maxPer100) + " per 100 bars" : "cooldown, " + str.tostring(math.max(math.max(cooldownIn, 1) - (bar_index - lastExitBar), 0)) + " bars left"

bool g12 = posState == 0
gatesTotal += 1
if g12
    gatesPassed += 1
else if vetoText == ""
    vetoText := "already in a position"

bool gateOpen = g1 and g2 and g3 and g4 and g5 and g6 and g7 and g8 and g9 and g10 and g11 and g12

// -- entries: confirmed bars only --------------------------------------------
bool buySig   = confirmed and gateOpen and propDir > 0
bool shortSig = confirmed and gateOpen and propDir < 0

float stopSigma   = f_clip(FM_STOP_SIGMA * (pStress > 0.2 ? 1.0 + 0.6 * pStress : 1.0) * (jumpShare > 0.4 ? 1.0 + 0.4 * (jumpShare - 0.4) / 0.6 : 1.0), 0.4, 8.0)
float stopDistVol = close * (1.0 - math.exp(-stopSigma * sigmaFcst))
float stopDistAtr = atrMultIn * nz(atrVal, stopDistVol)
float stopDist    = math.max(stopModeIn == STOP_ATR ? stopDistAtr : stopDistVol, syminfo.mintick)
float tgtDist     = stopDist * (stopModeIn == STOP_ATR ? rrIn : FM_TGT_SIGMA / FM_STOP_SIGMA)
float planStop    = propDir > 0 ? close - stopDist : close + stopDist
float planTarget  = propDir > 0 ? close + tgtDist : close - tgtDist

if buySig or shortSig
    posState := buySig ? 1 : -1
    entryPx  := close
    stopPx   := planStop
    targetPx := planTarget
    barsHeld := 0
    array.push(entryBars, bar_index)

// ════════════════════════════════════════════════════════════════════════════
// PRESENTATION
//
// Three layers, in the order the eye should read them:
//
//   1. TRADE ZONES — a risk box and a reward box drawn from the entry bar and
//      extended to the exit bar. These are box/line objects anchored by
//      bar_index, so they stretch and shrink with the candles as you zoom and
//      pan. The previous build put the trade's numbers in a four-line text
//      label instead, and labels are FIXED PIXEL SIZE: on a 5-minute chart one
//      spanned about fifteen candles and visually detached from the bar it
//      belonged to. Zones do not have that problem, and they show the whole
//      trade at a glance — where it began, what it risked, what it was aiming
//      at, and where it ended.
//
//   2. MARKERS — a small triangle at the entry, a cross at the exit, and a
//      result in R. Small enough to mark a bar rather than cover it. The
//      numbers live in the tooltip, so hovering gives detail without the
//      chart carrying it permanently.
//
//   3. STATUS PANEL — a table, and therefore pinned to the viewport by
//      construction; that is what a TradingView table is. It is the right
//      home for "what is true right now", not for one specific trade. Grouped
//      into sections so the two lines that matter — the state, and the reason
//      there is no trade — are legible at a glance.
// ════════════════════════════════════════════════════════════════════════════

// -- palette: TradingView's own dark-theme values, so it looks native --------
color C_PANEL  = color.new(#131722, 8)
color C_HEAD   = color.new(#1e222d, 0)
color C_SECT   = color.new(#1e222d, 20)
color C_BORDER = color.new(#2a2e39, 20)
color C_LABEL  = #787b86
color C_VALUE  = #d1d4dc
color C_MUTED  = #5d606b
color C_WARN   = #ff9800
color C_GOOD   = #26a69a

f_meter(float frac, int width) =>
    // A small bar built by concatenation. str.repeat would be shorter, but its
    // count argument's qualifier is not worth a compile round trip.
    int n = int(math.round(f_clip(frac, 0.0, 1.0) * float(width)))
    string outS = ""
    for i = 0 to math.max(width, 1) - 1
        outS := outS + (i < n ? "█" : "░")
    outS

f_rmult(int dir, float entry, float stop, float px) =>
    // The result in units of the trade's OWN initial risk. +1R means it made
    // exactly what it was risking; -1R is a clean stop-out. This is the only
    // scale on which trades of different sizes and volatilities compare.
    float risk = math.abs(entry - stop)
    risk <= 0.0 or na(entry) or na(px) ? 0.0 : (dir > 0 ? px - entry : entry - px) / risk

bool isEntryBar = buySig or shortSig
bool isExitBar  = sellSig or coverSig

// ── layer 1: trade zones, anchored to bars ─────────────────────────────────
var box  zRisk   = na
var box  zReward = na
var line lEntry  = na

if showTrades and isEntryBar
    color side = buySig ? upCol : dnCol
    zRisk := box.new(bar_index, math.max(close, planStop), bar_index + 1, math.min(close, planStop),
         border_color=color.new(dnCol, 55), border_width=1, bgcolor=color.new(dnCol, 90))
    zReward := box.new(bar_index, math.max(close, planTarget), bar_index + 1, math.min(close, planTarget),
         border_color=color.new(upCol, 55), border_width=1, bgcolor=color.new(upCol, 91))
    lEntry := line.new(bar_index, close, bar_index + 1, close,
         color=color.new(side, 25), style=line.style_dashed, width=1)

// Extend the open trade one bar at a time, and stop the moment it closes. The
// zones are never redrawn, so scrolling back shows exactly the history that was
// drawn as it happened.
if showTrades and not na(zRisk) and (posState != 0 or isExitBar)
    box.set_right(zRisk, bar_index + 1)
    box.set_right(zReward, bar_index + 1)
    line.set_x2(lEntry, bar_index + 1)

// ── layer 2: markers ───────────────────────────────────────────────────────
plotshape(showMarks and buySig,   title="BUY",   style=shape.triangleup,   location=location.belowbar, color=upCol,  size=size.tiny)
plotshape(showMarks and shortSig, title="SHORT", style=shape.triangledown, location=location.abovebar, color=dnCol,  size=size.tiny)
plotshape(showMarks and sellSig,  title="SELL",  style=shape.xcross,       location=location.abovebar, color=C_WARN, size=size.tiny)
plotshape(showMarks and coverSig, title="COVER", style=shape.xcross,       location=location.belowbar, color=C_WARN, size=size.tiny)

// Half an ATR of clearance so the label does not sit on top of the triangle.
// A fixed price offset would be wrong on every instrument but one.
float lblGap = nz(atrVal, 0.0) * 0.6

if showMarks and isEntryBar
    label.new(bar_index, buySig ? low - lblGap : high + lblGap,
         text=(buySig ? "LONG " : "SHORT ") + str.tostring(propConf, "#") + "%",
         style=buySig ? label.style_label_up : label.style_label_down,
         color=color.new(buySig ? upCol : dnCol, 10), textcolor=#ffffff,
         size=size.tiny, textalign=text.align_center,
         tooltip="entry " + str.tostring(close, format.mintick) +
             "\nstop " + str.tostring(planStop, format.mintick) +
             "\ntarget " + str.tostring(planTarget, format.mintick) +
             "\nsetup " + (setupIdx == 1 ? "sweep reversal" : setupIdx == 2 ? "compression break" : setupIdx == 3 ? "range fade" : "continuation") +
             "\nNOT market-validated")

// A running record of what this chart did. It is displayed with its own sample
// size next to it, because 14 trades cannot distinguish a real edge from a coin
// flip and the panel should say so rather than let the average speak alone.
var int   nClosed = 0
var int   nWon    = 0
var float sumR    = 0.0
if isExitBar
    float rDone = f_rmult(posBefore, entryPx, stopPx, exitPx)
    nClosed += 1
    nWon    += rDone > 0.0 ? 1 : 0
    sumR    += rDone

if showResult and isExitBar
    float rr = f_rmult(posBefore, entryPx, stopPx, exitPx)
    label.new(bar_index, sellSig ? high + lblGap : low - lblGap,
         text=(rr >= 0.0 ? "+" : "") + str.tostring(rr, "#.##") + "R  " + exitShort,
         style=sellSig ? label.style_label_down : label.style_label_up,
         color=color.new(rr >= 0.0 ? upCol : dnCol, 20), textcolor=#ffffff,
         size=size.tiny, textalign=text.align_center,
         tooltip="closed at " + str.tostring(exitPx, format.mintick) +
             "\nentry " + str.tostring(entryPx, format.mintick) +
             "\nheld " + str.tostring(heldAtExit) + " bars")

// ── regime tint: present but quiet. It is context, not a signal. ───────────
color regTint = domRegime == 0 ? color.new(upCol, 96) : domRegime == 1 ? color.new(#2962ff, 96) : domRegime == 2 ? color.new(dnCol, 95) : color.new(#787b86, 97)
bgcolor(showRegime and featuresValid ? regTint : color(na), title="Regime tint")

// ── layer 3: the status panel ──────────────────────────────────────────────
f_kv(table t, int r, string k, string v, color vc, string sz) =>
    table.cell(t, 0, r, " " + k, text_color=C_LABEL, text_size=sz, text_halign=text.align_left,  bgcolor=C_PANEL)
    table.cell(t, 1, r, v + " ", text_color=vc,      text_size=sz, text_halign=text.align_right, bgcolor=C_PANEL)

f_hi(table t, int r, string k, string v, color vc, string sz) =>
    // The row a reader looks at first deserves to be found first.
    table.cell(t, 0, r, " " + k, text_color=C_LABEL, text_size=sz, text_halign=text.align_left,  bgcolor=color.new(#2a2e39, 30))
    table.cell(t, 1, r, v + " ", text_color=vc,      text_size=sz, text_halign=text.align_right, bgcolor=color.new(#2a2e39, 30))

f_sec(table t, int r, string k, string sz) =>
    table.cell(t, 0, r, " " + k, text_color=C_MUTED, text_size=sz, text_halign=text.align_left,  bgcolor=C_SECT)
    table.cell(t, 1, r, "",      text_color=C_MUTED, text_size=sz, text_halign=text.align_right, bgcolor=C_SECT)

var table card = table.new(cardPosIn == "Top right" ? position.top_right : cardPosIn == "Middle right" ? position.middle_right : cardPosIn == "Bottom right" ? position.bottom_right : cardPosIn == "Top left" ? position.top_left : position.bottom_left, 2, 30, border_width=0, frame_width=1, frame_color=C_BORDER)

if cardModeIn != CARD_OFF and barstate.islast
    bool   full  = cardModeIn == CARD_FULL
    string tsz   = cardSizeIn == "Tiny" ? size.tiny : cardSizeIn == "Normal" ? size.normal : size.small
    bool   inPos = posState != 0

    string state = not featuresValid ? "WARMING UP" : buySig ? "BUY NOW" : shortSig ? "SHORT NOW" : sellSig ? "CLOSE LONG" : coverSig ? "CLOSE SHORT" : posState == 1 ? "HOLDING LONG" : posState == -1 ? "HOLDING SHORT" : "NO TRADE"
    color stateCol = not featuresValid ? color.new(C_WARN, 40) : buySig or posState == 1 ? color.new(upCol, 10) : shortSig or posState == -1 ? color.new(dnCol, 10) : sellSig or coverSig ? color.new(C_WARN, 10) : color.new(#2a2e39, 0)

    string setupTxt = setupIdx == 1 ? "sweep reversal" : setupIdx == 2 ? "compression break" : setupIdx == 3 ? "range fade" : "continuation"
    string regTxt   = domRegime == 0 ? "Trending" : domRegime == 1 ? "Mean-reverting" : domRegime == 2 ? "Stress" : "Quiet"
    float  liveR    = inPos ? f_rmult(posState, entryPx, stopPx, close) : 0.0

    table.clear(card, 0, 0, 1, 29)

    // headline: the one line to read first
    table.cell(card, 0, 0, " TI-A", text_color=#ffffff, text_size=tsz, text_halign=text.align_left, bgcolor=stateCol)
    table.cell(card, 1, 0, state + " ", text_color=#ffffff, text_size=tsz, text_halign=text.align_right, bgcolor=stateCol)

    int r = 1
    if inPos
        // ---- an open trade: everything needed to manage it -----------------
        f_sec(card, r, "OPEN TRADE", tsz)
        r += 1
        f_kv(card, r, posState == 1 ? "Long from" : "Short from", str.tostring(entryPx, format.mintick), C_VALUE, tsz)
        r += 1
        f_kv(card, r, "Stop — exit here", str.tostring(stopPx, format.mintick), dnCol, tsz)
        r += 1
        f_kv(card, r, "Target — exit here", str.tostring(targetPx, format.mintick), upCol, tsz)
        r += 1
        f_kv(card, r, "Open result", (liveR >= 0.0 ? "+" : "") + str.tostring(liveR, "#.##") + "R", liveR >= 0.0 ? upCol : dnCol, tsz)
        r += 1
        f_kv(card, r, "Held", str.tostring(barsHeld) + " of " + str.tostring(FM_MAX_HOLD) + " bars", C_VALUE, tsz)
        r += 1
        f_kv(card, r, "Also closes on", "reversal, or " + str.tostring(FM_MAX_HOLD) + " bars", C_LABEL, tsz)
        r += 1
    else
        // ---- flat: the proposal, and above all why it is not taken ---------
        f_sec(card, r, "SIGNAL", tsz)
        r += 1
        f_kv(card, r, "Direction", propDir > 0 ? "long" : propDir < 0 ? "short" : "none", propDir > 0 ? upCol : propDir < 0 ? dnCol : C_MUTED, tsz)
        r += 1
        // Number first, bar second. The bar spans 50% (a coin flip, empty) to
        // 95% (full), so 74% is legitimately a little over half a bar -- which
        // reads as a contradiction unless the scale is stated. Hence the
        // tooltip, and hence the number leading.
        table.cell(card, 0, r, " Confidence", text_color=C_LABEL, text_size=tsz, text_halign=text.align_left, bgcolor=C_PANEL,
             tooltip="The bar runs from 50% (a coin flip, empty) to 95% (full). It is not a probability of profit and no such claim is made.")
        table.cell(card, 1, r, str.tostring(propConf, "#") + "%  " + f_meter((propConf - 50.0) / 45.0, 10) + " ", text_color=C_VALUE, text_size=tsz, text_halign=text.align_right, bgcolor=C_PANEL,
             tooltip="The bar runs from 50% (a coin flip, empty) to 95% (full). It is not a probability of profit and no such claim is made.")
        r += 1
        f_kv(card, r, "Gates passed", str.tostring(gatesPassed) + "/" + str.tostring(gatesTotal) + "  " + f_meter(float(gatesPassed) / float(gatesTotal), 10), gatesPassed == gatesTotal ? C_GOOD : C_VALUE, tsz)
        r += 1
        f_hi(card, r, "Why no trade", gateOpen ? "ready to enter" : vetoText, gateOpen ? C_GOOD : C_WARN, tsz)
        r += 1
        if gateOpen
            f_kv(card, r, "Stop / target", str.tostring(planStop, format.mintick) + "  /  " + str.tostring(planTarget, format.mintick), C_VALUE, tsz)
            r += 1

    // ---- market context, always ------------------------------------------
    f_sec(card, r, "MARKET", tsz)
    r += 1
    f_kv(card, r, "Regime", regTxt + "  " + str.tostring(regimeCommit * 100.0, "#") + "%", C_VALUE, tsz)
    r += 1
    f_kv(card, r, "Setup", setupTxt, C_VALUE, tsz)
    r += 1
    f_kv(card, r, "Trend", na(slopeT) ? "n/a" : (slopeT > 0.5 ? "up" : slopeT < -0.5 ? "down" : "flat") + "  t " + str.tostring(slopeT, "#.#"), C_VALUE, tsz)
    r += 1

    if full
        f_kv(card, r, "Higher timeframe", na(htfSlopeT) ? "building" : htfSlopeT > 0.5 ? "up" : htfSlopeT < -0.5 ? "down" : "flat", C_VALUE, tsz)
        r += 1
        f_kv(card, r, "Momentum", moStrength > 0.3 ? (moDir > 0 ? "up, cheap" : "down, cheap") : "weak", C_VALUE, tsz)
        r += 1
        f_kv(card, r, "Volatility", (compression > 0.75 ? "compressed" : volRank > 0.85 ? "elevated" : volRank < 0.15 ? "very low" : "normal") + "  " + str.tostring(sigmaFcst * 100.0, "#.##") + "%/bar", C_VALUE, tsz)
        r += 1
        f_kv(card, r, "Liquidity", not hasVolume ? "no volume feed" : sweepAge <= 4 ? (sweepDir > 0 ? "low swept, reclaimed" : "high swept, rejected") : absorbing ? "absorbing" : "normal", C_VALUE, tsz)
        r += 1
        f_kv(card, r, "Regime hazard", str.tostring(hazard, "#.##"), hazard > (isModeA ? FM_RG_HAZ_MAX : bHazMax) ? C_WARN : C_VALUE, tsz)
        r += 1

        f_sec(card, r, "EVIDENCE", tsz)
        r += 1
        f_kv(card, r, "Log-odds", str.tostring(absL, "#.##"), C_VALUE, tsz)
        r += 1
        f_kv(card, r, "Independent breadth", str.tostring(ebeAligned, "#.##"), C_VALUE, tsz)
        r += 1
        f_kv(card, r, "Edge − cost", isModeA ? str.tostring(edgeLcb, "#.###") + " − " + str.tostring(roundTrip, "#.###") + " = " + str.tostring(evLcbNet, "#.###") : "not used in Mode B", isModeA and evLcbNet > FM_GATE_EVLCB ? C_GOOD : C_VALUE, tsz)
        r += 1
        f_kv(card, r, "Warm-up", featuresValid ? "ready" : str.tostring(math.max(WARMUP_BARS - bar_index, 0)) + " bars left", featuresValid ? C_VALUE : C_WARN, tsz)
        r += 1

        f_sec(card, r, "THIS CHART ONLY — NOT EVIDENCE", tsz)
        r += 1
        f_kv(card, r, "Closed trades", str.tostring(nClosed) + (nClosed > 0 ? "  ·  " + str.tostring(100.0 * float(nWon) / float(nClosed), "#") + "% won" : ""), C_VALUE, tsz)
        r += 1
        float avgR = nClosed > 0 ? sumR / float(nClosed) : 0.0
        f_kv(card, r, "Average result", nClosed > 0 ? (avgR >= 0.0 ? "+" : "") + str.tostring(avgR, "#.##") + "R" : "-", nClosed == 0 ? C_MUTED : avgR >= 0.0 ? upCol : dnCol, tsz)
        r += 1
        f_kv(card, r, "Statistical weight", nClosed >= 400 ? "n = " + str.tostring(nClosed) : "n = " + str.tostring(nClosed) + ", needs ~400", nClosed >= 400 ? C_VALUE : C_WARN, tsz)
        r += 1

    // ---- footer: the disclaimer never scrolls off -------------------------
    table.cell(card, 0, r, " " + syminfo.ticker + " " + timeframe.period + "  ·  " + (isModeA ? "Mode A" : "Mode B/" + str.tostring(strictIn)), text_color=C_MUTED, text_size=tsz, text_halign=text.align_left, bgcolor=C_HEAD)
    table.cell(card, 1, r, (FM_PLACEHOLDER ? "PLACEHOLDER MODEL" : "NOT market-validated") + " ", text_color=C_WARN, text_size=tsz, text_halign=text.align_right, bgcolor=C_HEAD)

// ════════════════════════════════════════════════════════════════════════════
// ALERTS
// Six static alertconditions - pick them from the Alerts dialog - plus dynamic
// alert() calls carrying the stop, target, confidence and mode in the body.
// ════════════════════════════════════════════════════════════════════════════
alertcondition(buySig,              title="TI-A BUY",       message="TI-A BUY {{ticker}} {{interval}} @ {{close}}")
alertcondition(sellSig,             title="TI-A SELL",      message="TI-A SELL (close long) {{ticker}} {{interval}} @ {{close}}")
alertcondition(shortSig,            title="TI-A SHORT",     message="TI-A SHORT {{ticker}} {{interval}} @ {{close}}")
alertcondition(coverSig,            title="TI-A COVER",     message="TI-A COVER (close short) {{ticker}} {{interval}} @ {{close}}")
alertcondition(buySig or shortSig,  title="TI-A any ENTRY", message="TI-A ENTRY {{ticker}} {{interval}} @ {{close}}")
alertcondition(sellSig or coverSig, title="TI-A any EXIT",  message="TI-A EXIT {{ticker}} {{interval}} @ {{close}}")

// Built by concatenation rather than str.format. str.format resolves against a
// typed overload set, so one upstream type error turns into a cascade of
// confusing complaints about its arguments; `+` on strings has no overloads to
// resolve. The ternaries need their parentheses -- `?:` binds looser than `+`.
if buySig or shortSig
    alert("TI-A " + (buySig ? "BUY" : "SHORT") + " | " + syminfo.ticker + " " + timeframe.period +
         " | signal " + str.tostring(close, format.mintick) +
         " | stop " + str.tostring(planStop, format.mintick) +
         " | target " + str.tostring(planTarget, format.mintick) +
         " | confidence " + str.tostring(propConf, "#.#") + "%" +
         " | mode " + (isModeA ? "A-frozen" : "B-observation") +
         " | NOT VALIDATED", alert.freq_once_per_bar_close)

if sellSig or coverSig
    alert("TI-A " + (sellSig ? "SELL" : "COVER") + " | " + syminfo.ticker + " " + timeframe.period +
         " | exit " + str.tostring(exitPx, format.mintick) +
         " | reason " + exitWhy +
         " | mode " + (isModeA ? "A-frozen" : "B-observation"), alert.freq_once_per_bar_close)
